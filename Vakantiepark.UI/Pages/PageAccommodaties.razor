@page "/accommodaties"
@inject IHttpService HttpService

<PageTitle>Verblijven | Vakantiepark D'r op Uut</PageTitle>

<section class="page-head">
    <div class="container">
        <div class="eyebrow">Verblijven</div>
        <h1 class="page-title mt-2">Waar ga jij d'r op uut?</h1>
        @if (types is not null)
        {
            <p class="page-intro mt-4">Het park heeft @UnitCount("HolidayHome") vakantiehuisjes en @UnitCount("CampingPitch") kampeerplaatsen, verdeeld over @types.Count verblijfstypes. Kies een type om de foto's en kenmerken te bekijken.</p>
        }
    </div>
</section>

@if (types is not null)
{
    <div class="stat-band">
        <div class="container">
            <div class="row text-center text-md-start">
                <div class="col-4 stat-item"><strong>@UnitCount("HolidayHome")</strong><div class="small text-muted-du">vakantiehuisjes</div></div>
                <div class="col-4 stat-item"><strong>@UnitCount("CampingPitch")</strong><div class="small text-muted-du">kampeerplaatsen</div></div>
                <div class="col-4 stat-item"><strong>@types.Count</strong><div class="small text-muted-du">verblijfstypes</div></div>
            </div>
        </div>
    </div>
}

<section class="section-pad">
    <div class="container">
        @if (errorMessage is not null)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }
        else if (types is null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-success" role="status">
                    <span class="visually-hidden">Bezig met laden...</span>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (AccommodationTypeResponse type in types)
                {
                    <div class="col-md-6 col-xl-4">
                        <AccommodationTypeCard Type="type" />
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private List<AccommodationTypeResponse>? types;
    private string? errorMessage;

    private int UnitCount(string category)
        => types?.Where(type => type.Category == category).Sum(type => type.UnitCount) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        ApiResponse<List<AccommodationTypeResponse>> response =
            await HttpService.GetAsync<List<AccommodationTypeResponse>>("AccommodationType");

        if (response.Succeeded)
            types = response.Value ?? [];
        else
            errorMessage = response.Message ?? "De verblijven konden niet worden geladen.";
    }
}
