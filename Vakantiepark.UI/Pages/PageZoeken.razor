@page "/zoeken"
@using Vakantiepark.Shared.DTOs.Accommodation
@inject ISearchService SearchService
@inject NavigationManager Navigation

<PageTitle>Zoeken | Vakantiepark D'r op Uut</PageTitle>

<section class="page-head">
    <div class="container">
        <div class="eyebrow">Zoeken en boek</div>
        <h1 class="page-title mt-2">Welk verblijf is vrij in jouw periode?</h1>
        <p class="page-intro mt-3 mb-0">
            Vul je periode, gezelschap en eventueel een voorkeurszone in. Je ziet meteen welke verblijven vrij zijn en wat het hele verblijf kost.
        </p>
    </div>
</section>

<section class="section-pad">
    <div class="container">
        @* No align-items-start: the left column must stretch to the results, or the sticky card has no room to move. *@
        <div class="row g-4">
            @* Filters on the left; sticky on large screens (booking-card from the template), stacked above the results on a phone. *@
            <div class="col-lg-4 col-xl-3">
                <aside class="booking-card zoek-sidebar">
                    <div class="eyebrow mb-3">Zoek &amp; boek</div>
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label fw-semibold" for="search-category">Soort verblijf</label>
                            <select id="search-category" class="form-select" @bind="SelectedCategory" @bind:after="OnCategoryChanged">
                                <option value="">Alles</option>
                                <option value="HolidayHome">Vakantiewoningen</option>
                                <option value="CampingPitch">Kampeerplaatsen</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold" for="search-type">Verblijf</label>
                            <select id="search-type" class="form-select" @bind="SelectedTypeSlug">
                                <option value="">Alle verblijven</option>
                                @foreach (TypeOption type in VisibleTypeOptions)
                                {
                                    <option value="@type.Slug">@type.Name (@FormatCategory.Format(type.Category))</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-lg-12">
                            <label class="form-label fw-semibold" for="search-arrival">Aankomst</label>
                            <InputDutchDate id="search-arrival" class="form-control" @bind-Value="ArrivalDate" IsValidChanged="OnArrivalDateValidityChanged" MinDate="@Today" MinYear="@Today.Year" RangeEnd="@DepartureDate" />
                        </div>
                        <div class="col-6 col-lg-12">
                            <label class="form-label fw-semibold" for="search-departure">Vertrek</label>
                            <InputDutchDate id="search-departure" class="form-control" @bind-Value="DepartureDate" IsValidChanged="OnDepartureDateValidityChanged" MinDate="@ArrivalDate.AddDays(1)" MinYear="@Today.Year" RangeStart="@ArrivalDate" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold" for="search-guests">Personen</label>
                            <InputNumber id="search-guests" class="form-control" @bind-Value="NumberOfGuests" min="1" step="1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold" for="search-pets">Huisdieren</label>
                            <select id="search-pets" class="form-select" @bind="NumberOfPets">
                                <option value="0">Geen</option>
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold" for="search-zone">Voorkeurszone</label>
                            <select id="search-zone" class="form-select" @bind="SelectedZoneId">
                                <option value="">Geen voorkeur</option>
                                @foreach (ZoneOptionResponse zone in AvailableZones)
                                {
                                    <option value="@zone.Id">@zone.Name@(zone.Category == "CampingPitch" ? " (kampeerplaats)" : "")</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="check-field" for="search-wheelchair">
                                <input id="search-wheelchair" class="form-check-input" type="checkbox" @bind="WheelchairAccessible" />
                                Rolstoeltoegankelijk
                            </label>
                        </div>
                        <div class="col-12 zoek-submit">
                            <button type="button" class="btn btn-du w-100 py-3" @onclick="SearchAsync" disabled="@isSearching">
                                @(isSearching ? "Zoeken…" : "Beschikbaarheid zoeken")
                            </button>
                        </div>
                    </div>
                </aside>
            </div>

            <div class="col-lg-8 col-xl-9">
                @if (errorMessage is not null)
                {
                    <div class="alert alert-danger mb-4" role="alert">@errorMessage</div>
                }
                else if (searchMessage is not null)
                {
                    <div class="alert alert-info mb-4" role="alert">@searchMessage</div>
                }

                @if (isSearching)
                {
                    <div class="p-4 border rounded-4 bg-white shadow-sm" role="status">Op zoek naar beschikbare verblijven…</div>
                }
                else if (results is not null && results.Count > 0 && searched is not null)
                {
                    <div class="row g-4">
                        @foreach (AccommodationTypeAvailability availability in results)
                        {
                            <div class="col-md-6">
                                <article class="type-card zoek-result-card">
                                    <img src="@($"img/accommodaties/{availability.Slug}/1.webp")"
                                         alt="@availability.Name" loading="lazy"
                                         onerror="this.onerror=null;this.src='img/placeholder-image.svg'" />
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between gap-3 align-items-start">
                                            <div>
                                                <div class="eyebrow">@FormatCategory.Format(availability.Category)</div>
                                                <h2 class="h3 mt-2 mb-0">@availability.Name</h2>
                                            </div>
                                            <span class="count-pill text-nowrap">tot @availability.MaxPersons pers.</span>
                                        </div>
                                        <div class="d-flex flex-wrap gap-2 mt-3">
                                            <span class="feature-chip">@availability.AvailableUnitCount @(availability.AvailableUnitCount == 1 ? "vrije eenheid" : "vrije eenheden")</span>
                                            @foreach (ZoneAvailability zone in availability.Zones)
                                            {
                                                <span class="feature-chip">@zone.Name · @zone.AvailableUnitCount vrij</span>
                                            }
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mt-4 gap-3 flex-wrap">
                                            <div>
                                                <div class="small text-muted-du">Totaal voor @NightsLabel(searched)</div>
                                                <div class="zoek-price">@availability.TotalPrice.ToString("C")</div>
                                            </div>
                                            <a class="btn btn-du" href="@BookingUrl(availability.Slug, searched)">Bekijken en boeken</a>
                                        </div>
                                    </div>
                                </article>
                            </div>
                        }
                    </div>
                }
                else if (results is null && errorMessage is null && searchMessage is null)
                {
                    <div class="p-4 p-md-5 border rounded-4 bg-white text-center text-muted-du">
                        Vul links je periode en reisgezelschap in en klik op <strong>Beschikbaarheid zoeken</strong>.
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private List<TypeOption> TypeOptions = [];
    private List<ZoneOptionResponse> allZones = [];
    private List<AccommodationTypeAvailability>? results;

    // The criteria of the last search: the booking link and the night count use these,
    // so changing a field after searching never sends the guest on with other values.
    private SearchCriteria? searched;

    private string SelectedCategory = "";
    private string SelectedTypeSlug = "";

    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeFromQuery { get; set; }

    // The quick search on the homepage (US-42) and on the detail page of a type (US-45) sends these.
    [SupplyParameterFromQuery(Name = "aankomst")]
    public DateOnly? ArrivalFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "vertrek")]
    public DateOnly? DepartureFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "personen")]
    public int? GuestsFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "soort")]
    public string? CategoryFromQuery { get; set; }

    private string SelectedZoneId = "";
    private int NumberOfGuests = 2;
    private int NumberOfPets = 0;
    private bool WheelchairAccessible;
    private DateOnly ArrivalDate = DateOnly.FromDateTime(DateTime.Today).AddDays(7);
    private DateOnly DepartureDate = DateOnly.FromDateTime(DateTime.Today).AddDays(11);
    private bool isArrivalDateValid = true;
    private bool isDepartureDateValid = true;

    private bool isSearching;
    private string? errorMessage;
    private string? searchMessage;

    private DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    private List<TypeOption> VisibleTypeOptions =>
        string.IsNullOrWhiteSpace(SelectedCategory)
            ? TypeOptions
            : TypeOptions.Where(type => type.Category == SelectedCategory).ToList();

    // Zones of the chosen type's category, else of the chosen category, else all.
    private List<ZoneOptionResponse> AvailableZones
    {
        get
        {
            string category = string.IsNullOrWhiteSpace(SelectedTypeSlug) ? SelectedCategory : TypeCategoryOf(SelectedTypeSlug);
            return string.IsNullOrWhiteSpace(category)
                ? allZones
                : allZones.Where(zone => zone.Category == category).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ApiResponse<List<AccommodationResponse>> accommodations = await SearchService.GetAccommodationsAsync();
        ApiResponse<List<ZoneOptionResponse>> zones = await SearchService.GetZoneOptionsAsync();

        if (!accommodations.Succeeded || accommodations.Value is null)
        {
            errorMessage = accommodations.Message ?? "De verblijven konden niet worden geladen. Probeer het later opnieuw.";
            return;
        }

        TypeOptions = accommodations.Value
            .GroupBy(accommodation => accommodation.TypeSlug)
            .Select(group => new TypeOption(
                group.Key,
                group.First().TypeName,
                group.First().Category))
            .OrderBy(type => type.Name)
            .ToList();

        allZones = zones.Succeeded && zones.Value is not null ? zones.Value : [];

        ApplyQuerySearch();
        ApplyQueryType();

        if (ArrivalFromQuery is not null && DepartureFromQuery is not null)
            await SearchAsync();
    }

    private void ApplyQuerySearch()
    {
        ArrivalDate = ArrivalFromQuery ?? ArrivalDate;
        DepartureDate = DepartureFromQuery ?? DepartureDate;
        NumberOfGuests = GuestsFromQuery ?? NumberOfGuests;
        SelectedCategory = CategoryFromQuery?.ToLowerInvariant() switch
        {
            "vakantiewoningen" => "HolidayHome",
            "kampeerplaatsen" => "CampingPitch",
            _ => SelectedCategory,
        };
    }

    // Criterion: ?type=… in the URL preselects the accommodation type, if it fits the chosen category.
    private void ApplyQueryType()
    {
        if (!string.IsNullOrWhiteSpace(TypeFromQuery) && VisibleTypeOptions.Any(type => type.Slug == TypeFromQuery))
            SelectedTypeSlug = TypeFromQuery;
    }

    protected override void OnParametersSet() => ApplyQueryType();

    // A type or zone of the other category no longer fits, so it is cleared.
    private void OnCategoryChanged()
    {
        if (!VisibleTypeOptions.Any(type => type.Slug == SelectedTypeSlug))
            SelectedTypeSlug = "";

        if (!AvailableZones.Any(zone => zone.Id.ToString() == SelectedZoneId))
            SelectedZoneId = "";
    }

    private void OnArrivalDateValidityChanged(bool isValid)
        => isArrivalDateValid = isValid;

    private void OnDepartureDateValidityChanged(bool isValid)
        => isDepartureDateValid = isValid;

    private async Task SearchAsync()
    {
        errorMessage = null;
        searchMessage = null;
        results = null;

        if (!isArrivalDateValid || !isDepartureDateValid)
        {
            errorMessage = "Vul een geldige aankomst- en vertrekdatum in voordat je zoekt.";
            return;
        }

        if (ArrivalDate < Today)
        {
            errorMessage = "Je aankomstdatum ligt in het verleden. Kies een latere aankomstdatum.";
            return;
        }
        if (DepartureDate <= ArrivalDate)
        {
            errorMessage = "Je vertrekdatum moet na je aankomstdatum liggen. Pas je data aan.";
            return;
        }

        Guid? zoneId = Guid.TryParse(SelectedZoneId, out Guid parsedZone) ? parsedZone : null;
        SearchCriteria criteria = new SearchCriteria(
            string.IsNullOrWhiteSpace(SelectedTypeSlug) ? null : SelectedTypeSlug,
            string.IsNullOrWhiteSpace(SelectedCategory) ? null : SelectedCategory,
            ArrivalDate, DepartureDate, NumberOfGuests, NumberOfPets, WheelchairAccessible,
            zoneId, allZones.FirstOrDefault(zone => zone.Id == zoneId)?.Name);

        // Also shows "Zoeken…" when the search starts from the URL, where no click re-renders the page.
        isSearching = true;
        StateHasChanged();
        ApiResponse<AccommodationSearchResponse> response = await SearchService.SearchAsync(
            criteria.TypeSlug, criteria.Category, criteria.ArrivalDate, criteria.DepartureDate,
            criteria.NumberOfGuests, criteria.NumberOfPets, criteria.WheelchairAccessible, criteria.ZoneId);
        isSearching = false;

        if (!response.Succeeded || response.Value is null)
        {
            errorMessage = response.Message ?? "Zoeken is nu niet gelukt. Probeer het later opnieuw.";
            return;
        }

        searched = criteria;
        results = response.Value.Results;
        searchMessage = response.Value.Message;
    }

    // Everything the guest searched on travels to the booking page (US-36).
    private static string BookingUrl(string slug, SearchCriteria criteria)
        => new QueryString()
            .Add("type", slug)
            .Add("aankomst", criteria.ArrivalDate)
            .Add("vertrek", criteria.DepartureDate)
            .Add("personen", criteria.NumberOfGuests)
            .Add("huisdieren", criteria.NumberOfPets)
            .Add("rolstoel", criteria.WheelchairAccessible)
            .Add("zone", criteria.ZoneName)
            .ToUrl("/zoek-en-boek");

    private static string NightsLabel(SearchCriteria criteria)
        => StayLabels.Nights(StayLabels.NumberOfNights(criteria.ArrivalDate, criteria.DepartureDate));

    private string TypeCategoryOf(string slug) =>
        TypeOptions.FirstOrDefault(type => type.Slug == slug)?.Category ?? "";

    private sealed record TypeOption(string Slug, string Name, string Category);

    private sealed record SearchCriteria(
        string? TypeSlug, string? Category, DateOnly ArrivalDate, DateOnly DepartureDate,
        int NumberOfGuests, int NumberOfPets, bool WheelchairAccessible, Guid? ZoneId, string? ZoneName);
}
