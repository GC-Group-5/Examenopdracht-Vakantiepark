@inject NavigationManager NavigationManager

@code {
    // Sends a visitor who may not see this page (not logged in, or with another role) to the login page,
    // and back to where they were going after logging in with an account that may.
    protected override void OnInitialized()
    {
        string returnUrl = Uri.EscapeDataString("/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
        NavigationManager.NavigateTo($"beheer/inloggen?returnUrl={returnUrl}", replace: true);
    }
}
