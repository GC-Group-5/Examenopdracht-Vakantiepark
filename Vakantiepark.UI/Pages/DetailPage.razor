@page "/accommodaties/{TypeSlug}"
@inject IHttpService HttpService

@if (isLoading)
{
    <div class="container py-5 text-center">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">Bezig met laden...</span>
        </div>
    </div>
}
else if (loadError is not null)
{
    <PageTitle>Verblijven | Vakantiepark D'r op Uut</PageTitle>
    <section class="page-head">
        <div class="container">
            <div class="eyebrow">Oeps</div>
            <h1 class="page-title mt-2">Het verblijf kon niet worden geladen.</h1>
            <p class="page-intro mt-4">@loadError</p>
        </div>
    </section>
}
else if (type is null)
{
    <PageTitle>Verblijf niet gevonden | Vakantiepark D'r op Uut</PageTitle>
    <section class="page-head">
        <div class="container">
            <div class="eyebrow">404 · Verblijf niet gevonden</div>
            <h1 class="page-title mt-2">Dit verblijf bestaat niet.</h1>
            <p class="page-intro mt-4">
                We kunnen het verblijf dat je zoekt niet vinden. Misschien is de link verouderd
                of staat er een typefout in het adres.
            </p>
            <div class="d-flex flex-wrap gap-2 mt-4">
                <a class="btn btn-du" href="/accommodaties">Bekijk alle verblijven</a>
                <a class="btn btn-du-light" href="/">Naar de homepage</a>
            </div>
        </div>
    </section>
}
else
{
    <PageTitle>@type.Name | Vakantiepark D'r op Uut</PageTitle>

    <section class="detail-hero">
        <div class="container">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb small">
                    <li class="breadcrumb-item"><a href="/accommodaties">Verblijven</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@type.Name</li>
                </ol>
            </nav>
            <div class="mosaic">
                <img class="tall" src="@Image(1)" alt="@type.Name" />
                <div class="stack">
                    @foreach (int number in StackImages)
                    {
                        <img src="@Image(number)" alt="" />
                    }
                </div>
            </div>
            <div class="detail-meta">
                <div class="row">
                    <div class="col-xl-9">
                        <div class="detail-meta-card">
                            <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                                <span class="eyebrow">@FormatCategory.Format(type.Category) · @type.UnitCount op het park</span>
                                <span class="count-pill">Tot @type.MaxPersons personen</span>
                            </div>
                            <h1 class="page-title mb-3">@type.Name</h1>
                            <p class="lead text-muted-du mb-0">@type.Description</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-pad">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-8">
                    <div class="eyebrow">Dit kun je verwachten</div>
                    <h2 class="section-title">Comfort met een Achterhoekse knipoog.</h2>
                    <p class="text-muted-du mt-4">Niet iedere fysieke @(IsHolidayHome ? "woning" : "plaats") binnen dit type is exact hetzelfde. Eigenschappen zoals ligging, huisdieren, laadpunt of extra voorzieningen kunnen per eenheid verschillen.</p>
                    <div class="d-flex flex-wrap gap-2 mt-4">
                        @foreach (string highlight in type.Highlights)
                        {
                            <span class="feature-chip">@highlight</span>
                        }
                    </div>
                    <div class="zone-card mt-5">
                        <h3 class="h4">Waar op het park?</h3>
                        <p class="mb-0 text-muted-du">Dit type vind je op het park in: <strong>@string.Join(", ", type.Zones)</strong>.</p>
                    </div>
                    @if (IsHolidayHome)
                    {
                        <section class="mt-5 pt-4">
                            <div class="eyebrow">Indeling</div>
                            <h2 class="section-title mb-4">Plattegrond</h2>
                            <div class="floor-card">
                                <img src="@($"img/accommodaties/{type.Slug}/plattegrond.webp")" alt="Plattegrond @type.Name" />
                            </div>
                        </section>
                    }
                </div>
                <div class="col-lg-4">
                    <aside class="booking-card">
                        <div class="eyebrow">Zoek &amp; boek</div>
                        <h3 class="h2 mt-2">Wanneer wil je d'r op uut?</h3>
                        <p class="small text-muted-du">Kies je data en reisgezelschap en zie direct of dit verblijf vrij is.</p>
                        <div class="row g-2 mt-1">
                            <div class="col-6"><div class="fake-input">Aankomst<br /><b>dd-mm-jjjj</b></div></div>
                            <div class="col-6"><div class="fake-input">Vertrek<br /><b>dd-mm-jjjj</b></div></div>
                            <div class="col-12"><div class="fake-input">Gezelschap<br /><b>1–@type.MaxPersons personen</b></div></div>
                        </div>
                        <a href="@($"/zoek-en-boek?type={type.Slug}")" class="btn btn-du w-100 mt-3">Controleer beschikbaarheid</a>
                    </aside>
                </div>
            </div>
        </div>
    </section>
}

@code {
    [Parameter]
    public string TypeSlug { get; set; } = string.Empty;

    private AccommodationTypeResponse? type;
    private bool isLoading = true;
    private string? loadError;

    private bool IsHolidayHome => type?.Category == "HolidayHome";

    // Holiday homes have three photos, camping pitches two.
    private IEnumerable<int> StackImages => IsHolidayHome ? new[] { 2, 3 } : new[] { 2 };

    private string Image(int number) => $"img/accommodaties/{type?.Slug}/{number}.webp";

    // The list of 12 types is small; loading it lets an unknown slug show "niet gevonden"
    // and a failing API an error, which the single-type endpoint can't tell apart here.
    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        loadError = null;

        ApiResponse<List<AccommodationTypeResponse>> response =
            await HttpService.GetAsync<List<AccommodationTypeResponse>>("AccommodationType");

        if (response.Succeeded)
            type = (response.Value ?? []).FirstOrDefault(item => item.Slug.Equals(TypeSlug, StringComparison.OrdinalIgnoreCase));
        else
            loadError = response.Message ?? "Probeer het later opnieuw.";

        isLoading = false;
    }
}
