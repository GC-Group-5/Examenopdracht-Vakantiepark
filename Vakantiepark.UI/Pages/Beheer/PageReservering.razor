@page "/beheer/reserveringen/{Id:guid}"
@attribute [Authorize(Roles = Roles.Staff)]
@using Vakantiepark.Shared.DTOs.Accommodation
@using Vakantiepark.Shared.DTOs.Booking
@using Vakantiepark.Shared.DTOs.Reservations
@using Vakantiepark.UI.Application.Extensions
@inject IReservationService ReservationService
@inject IJSRuntime JSRuntime

<PageTitle>@(reservation is null ? "Reservering" : $"Reservering {reservation.BookingNumber}") | Vakantiepark D'r op Uut</PageTitle>

<section class="page-head">
    <div class="container">
        <div class="eyebrow">Beheeromgeving · Reserveringen</div>
        <h1 class="page-title mt-2">@(reservation is null ? "Reservering" : $"Reservering {reservation.BookingNumber}")</h1>
        @if (reservation is not null)
        {
            <p class="page-intro mt-3 mb-0">@reservation.Name · @reservation.AccommodationTypeName · @reservation.ArrivalDate.ToString(DateFormat) t/m @reservation.DepartureDate.ToString(DateFormat)</p>
        }
        <button type="button" class="btn btn-du-light mt-3" @onclick="BackAsync">Terug naar de lijst</button>
    </div>
</section>

<section class="section-pad">
    <div class="container">
        @if (errorMessage is not null)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }
        else if (reservation is null)
        {
            <div class="text-center py-5" role="status">
                <div class="spinner-border text-success"><span class="visually-hidden">Reservering wordt geladen…</span></div>
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-12 col-lg-7">
                    <div class="detail-meta-card h-100">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
                            <h2 class="h4 mb-0">Gegevens</h2>
                            <span class="badge rounded-pill @BookingStatusBadge.CssClass(reservation.Status) fs-6">@reservation.Status</span>
                        </div>

                        <dl class="row mb-0">
                            <dt class="col-sm-4">Boekingsnummer</dt>
                            <dd class="col-sm-8">@reservation.BookingNumber</dd>

                            <dt class="col-sm-4">Geboekt op</dt>
                            <dd class="col-sm-8">@reservation.CreatedAt.ToLocalTime().ToString($"{DateFormat} {TimeFormat}")</dd>

                            <dt class="col-sm-4">Verblijf</dt>
                            <dd class="col-sm-8">@reservation.AccommodationTypeName · @reservation.UnitCode · zone @reservation.Zone</dd>

                            <dt class="col-sm-4">Data</dt>
                            <dd class="col-sm-8">@reservation.ArrivalDate.ToString(DateFormat) t/m @reservation.DepartureDate.ToString(DateFormat) (@NumberOfNights @(NumberOfNights == 1 ? "nacht" : "nachten"))</dd>

                            <dt class="col-sm-4">Aankomst en vertrek</dt>
                            <dd class="col-sm-8">Aankomst vanaf @reservation.ArrivalTime.ToString(TimeFormat), vertrek vóór @reservation.DepartureTime.ToString(TimeFormat)</dd>

                            <dt class="col-sm-4">Reisgezelschap</dt>
                            <dd class="col-sm-8">
                                @TravellerAgeExtensions.PartyLabel(reservation.NumberOfGuests, reservation.NumberOfChildrenUnder12)
                                <ul class="list-unstyled mb-0">
                                    @foreach (GuestResponse guest in reservation.Guests)
                                    {
                                        <li>@TravellerAgeExtensions.TravellerLabel(guest.Name, guest.BirthDate, reservation.ArrivalDate, guest.IsMainBooker)</li>
                                    }
                                </ul>
                                @if (TravellerAgeExtensions.MissingTravellersLabel(reservation.NumberOfGuests, reservation.Guests.Count) is string missing)
                                {
                                    <div class="text-muted-du small">@missing</div>
                                }
                            </dd>

                            <dt class="col-sm-4">Huisdieren</dt>
                            <dd class="col-sm-8">@(reservation.NumberOfPets == 0 ? "Geen" : $"{reservation.NumberOfPets} {(reservation.NumberOfPets == 1 ? "huisdier" : "huisdieren")}")</dd>

                            <dt class="col-sm-4">Rolstoeltoegankelijk</dt>
                            <dd class="col-sm-8">@(reservation.WheelchairAccessible ? "Ja" : "Nee")</dd>

                            <dt class="col-sm-4">Contactgegevens</dt>
                            <dd class="col-sm-8 mb-0">@reservation.Name<br /><a class="admin-link fw-normal" href="mailto:@reservation.Email">@reservation.Email</a><br /><a class="admin-link fw-normal" href="tel:@reservation.PhoneNumber">@reservation.PhoneNumber</a></dd>
                        </dl>
                    </div>
                </div>

                <div class="col-12 col-lg-5">
                    <div class="detail-meta-card h-100">
                        <h2 class="h4 mb-3">Prijsspecificatie</h2>
                        <table class="table mb-0">
                            <tbody>
                                <tr><td>Verblijf (@NumberOfNights @(NumberOfNights == 1 ? "nacht" : "nachten"))</td><td class="text-end">@reservation.AccommodationPrice.ToString("C")</td></tr>
                                <tr><td>Eindschoonmaak</td><td class="text-end">@reservation.CleaningFee.ToString("C")</td></tr>
                                @if (reservation.PetCleaningFee > 0m)
                                {
                                    <tr><td>Schoonmaakkosten huisdieren</td><td class="text-end">@reservation.PetCleaningFee.ToString("C")</td></tr>
                                }
                                <tr><td>Toeristenbelasting</td><td class="text-end">@reservation.TouristTax.ToString("C")</td></tr>
                                <tr class="fw-semibold"><td>Totaal</td><td class="text-end">@reservation.TotalPrice.ToString("C")</td></tr>
                                <tr><td>Borg (retour bij vertrek)<div class="small text-muted-du">Innen bij aankomst, terugbetalen bij vertrek</div></td><td class="text-end">@reservation.SecurityDeposit.ToString("C")</td></tr>
                                <tr><td>Aanbetaling</td><td class="text-end">@reservation.Deposit.ToString("C")</td></tr>
                                @if (reservation.CancellationFee is not null)
                                {
                                    <tr class="fw-semibold"><td class="text-danger">Annuleringskosten</td><td class="text-end text-danger">@reservation.CancellationFee.Value.ToString("C")</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @if (successMessage is not null)
            {
                <div class="alert alert-success mt-4" role="status">@successMessage</div>
            }

            @if (actionError is not null)
            {
                <div class="alert alert-danger mt-4" role="alert">@actionError</div>
            }

            @if (mode == Mode.View && !IsCancelled)
            {
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="button" class="btn btn-du" @onclick="StartChangeAsync" disabled="@isBusy">Wijzigen</button>
                    <button type="button" class="btn btn-du-light text-danger" @onclick="StartCancelAsync" disabled="@isBusy">Annuleren</button>
                </div>
            }

            @if (mode == Mode.Change)
            {
                <EditForm Model="changeRequest" OnValidSubmit="SaveChangeAsync" class="detail-meta-card mt-4">
                    <DataAnnotationsValidator />
                    <h2 class="h4 mb-1">Reservering wijzigen</h2>
                    <p class="text-muted-du small">Dezelfde controles als bij boeken; de termijn voor gasten geldt hier niet. De prijs wordt opnieuw berekend.</p>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="edit-name">Naam hoofdboeker</label>
                            <InputText id="edit-name" class="form-control" @bind-Value="changeRequest.Name" />
                            <ValidationMessage For="() => changeRequest.Name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="edit-birthdate">Geboortedatum hoofdboeker</label>
                            <InputDutchDate id="edit-birthdate" class="form-control" MaxYear="@Today.Year" @bind-Value="changeRequest.BirthDate" />
                            <ValidationMessage For="() => changeRequest.BirthDate" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="edit-email">E-mailadres</label>
                            <InputText id="edit-email" type="email" class="form-control" @bind-Value="changeRequest.Email" />
                            <ValidationMessage For="() => changeRequest.Email" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="edit-phone">Telefoonnummer</label>
                            <InputText id="edit-phone" type="tel" class="form-control" @bind-Value="changeRequest.PhoneNumber" />
                            <ValidationMessage For="() => changeRequest.PhoneNumber" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="edit-arrival">Aankomst</label>
                            <InputDutchDate id="edit-arrival" class="form-control" MinYear="@Today.Year" @bind-Value="changeRequest.ArrivalDate" RangeEnd="@changeRequest.DepartureDate" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="edit-departure">Vertrek</label>
                            <InputDutchDate id="edit-departure" class="form-control" MinYear="@Today.Year" @bind-Value="changeRequest.DepartureDate" RangeStart="@changeRequest.ArrivalDate" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" for="edit-guests">Aantal personen</label>
                            <InputNumber id="edit-guests" class="form-control" @bind-Value="changeRequest.NumberOfGuests" min="1" step="1" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" for="edit-children">Waarvan jonger dan 12</label>
                            <InputNumber id="edit-children" class="form-control" @bind-Value="changeRequest.NumberOfChildrenUnder12" min="0" max="@(changeRequest.NumberOfGuests - 1)" step="1" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" for="edit-unit">Eenheid</label>
                            <InputSelect id="edit-unit" class="form-select" @bind-Value="changeRequest.AccommodationUnitCode">
                                <option value="">Huidige houden (@reservation.UnitCode) als die vrij is</option>
                                @foreach (AccommodationResponse unit in UnitsOfType)
                                {
                                    <option value="@unit.Code">@unit.Code · zone @unit.Zone</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-du" disabled="@isBusy">@(isBusy ? "Bezig met opslaan…" : "Wijziging opslaan")</button>
                        <button type="button" class="btn btn-du-light" @onclick="CloseAction" disabled="@isBusy">Terug</button>
                    </div>
                </EditForm>
            }

            @if (mode == Mode.Cancel && cancelQuote is not null)
            {
                <EditForm Model="cancelRequest" OnValidSubmit="ConfirmCancelAsync" class="detail-meta-card mt-4">
                    <DataAnnotationsValidator />
                    <h2 class="h4 mb-1">Reservering annuleren</h2>
                    <p class="mb-1">Annuleringskosten: <strong>@cancelQuote.CancellationFee.ToString("C")</strong> van @cancelQuote.TotalPrice.ToString("C")</p>
                    <p class="text-muted-du small">@cancelQuote.Explanation</p>

                    <label class="form-label fw-semibold" for="cancel-reason">Reden van de annulering</label>
                    <InputTextArea id="cancel-reason" class="form-control" rows="3" @bind-Value="cancelRequest.Reason" />
                    <ValidationMessage For="() => cancelRequest.Reason" />

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-du" disabled="@isBusy">@(isBusy ? "Bezig met annuleren…" : "Annulering bevestigen")</button>
                        <button type="button" class="btn btn-du-light" @onclick="CloseAction" disabled="@isBusy">Terug</button>
                    </div>
                </EditForm>
            }

            <div class="detail-meta-card mt-4">
                <h2 class="h4 mb-3">Wijzigingen</h2>
                @if (reservation.Changes.Count == 0)
                {
                    <p class="text-muted-du mb-0">Nog niet gewijzigd door een medewerker.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (BookingChangeResponse change in reservation.Changes)
                        {
                            <li class="mb-2">
                                <span class="fw-semibold">@change.ChangedAt.ToLocalTime().ToString($"{DateFormat} {TimeFormat}") · @change.StaffName</span><br />
                                @change.Description
                                @if (change.Reason is not null)
                                {
                                    <br /><span class="text-muted-du">Reden: @change.Reason</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        }
    </div>
</section>

@code {
    private const string DateFormat = DateFormats.Date;
    private const string TimeFormat = DateFormats.Time;

    [Parameter]
    public Guid Id { get; set; }

    private enum Mode { View, Change, Cancel }

    private ReservationDetailResponse? reservation;
    private string? errorMessage;
    private Mode mode = Mode.View;
    private StaffChangeBookingRequest changeRequest = new StaffChangeBookingRequest();
    private StaffCancelBookingRequest cancelRequest = new StaffCancelBookingRequest();
    private CancellationQuoteResponse? cancelQuote;
    private List<AccommodationResponse> units = [];
    private bool isBusy;
    private string? actionError;
    private string? successMessage;

    private int NumberOfNights => reservation is null ? 0 : reservation.DepartureDate.DayNumber - reservation.ArrivalDate.DayNumber;

    private bool IsCancelled => reservation?.Status == BookingStatuses.Geannuleerd;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    // Staff may move a booking to another unit of the same type (US-14).
    private List<AccommodationResponse> UnitsOfType => reservation is null
        ? []
        : units
            .Where(unit => unit.TypeName == reservation.AccommodationTypeName)
            .OrderBy(unit => unit.Code)
            .ToList();

    protected override async Task OnParametersSetAsync()
    {
        reservation = null;
        errorMessage = null;

        ApiResponse<ReservationDetailResponse> response = await ReservationService.GetAsync(Id);
        if (response.Succeeded && response.Value is not null)
            reservation = response.Value;
        else
            errorMessage = response.Message ?? "De reservering kon niet worden geladen. Probeer het later opnieuw.";
    }

    // Back in the browser history keeps the search and page the staff member came from.
    private async Task BackAsync()
        => await JSRuntime.InvokeVoidAsync("history.back");

    // The form starts with the booking as it is now; fellow travellers already known are kept.
    private async Task StartChangeAsync()
    {
        if (reservation is null)
            return;

        if (units.Count == 0)
        {
            ApiResponse<List<AccommodationResponse>> response = await ReservationService.GetUnitsAsync();
            units = response.Succeeded && response.Value is not null ? response.Value : [];
        }

        GuestResponse? mainBooker = reservation.Guests.FirstOrDefault(guest => guest.IsMainBooker);
        changeRequest = new StaffChangeBookingRequest()
        {
            Name = reservation.Name,
            Email = reservation.Email,
            PhoneNumber = reservation.PhoneNumber,
            BirthDate = mainBooker?.BirthDate,
            ArrivalDate = reservation.ArrivalDate,
            DepartureDate = reservation.DepartureDate,
            NumberOfGuests = reservation.NumberOfGuests,
            NumberOfChildrenUnder12 = reservation.NumberOfChildrenUnder12,
            CoTravellers = reservation.Guests
                .Where(guest => !guest.IsMainBooker)
                .Select(guest => new TravellerRequest() { Name = guest.Name, BirthDate = guest.BirthDate })
                .ToList(),
        };
        ClearMessages();
        mode = Mode.Change;
    }

    // Fewer persons than known travellers: the last travellers are dropped, as the server allows no more.
    private async Task SaveChangeAsync()
    {
        changeRequest.CoTravellers = changeRequest.CoTravellers
            .Take(Math.Max(changeRequest.NumberOfGuests - 1, 0))
            .ToList();

        await SaveAsync(() => ReservationService.ChangeAsync(Id, changeRequest), "De reservering is gewijzigd. De gast krijgt een e-mail.");
    }

    // Staff first sees the same costs as the guest would (US-12).
    private async Task StartCancelAsync()
    {
        ClearMessages();
        cancelRequest = new StaffCancelBookingRequest();
        isBusy = true;

        ApiResponse<CancellationQuoteResponse> response = await ReservationService.GetCancellationQuoteAsync(Id);

        isBusy = false;
        if (!response.Succeeded || response.Value is null)
        {
            actionError = response.Message ?? "De annuleringskosten konden niet worden berekend.";
            return;
        }

        cancelQuote = response.Value;
        mode = Mode.Cancel;
    }

    private async Task ConfirmCancelAsync()
        => await SaveAsync(() => ReservationService.CancelAsync(Id, cancelRequest), "De reservering is geannuleerd. De gast krijgt een e-mail.");

    // Both actions return the reservation as it is now, so the details and the log update at once.
    private async Task SaveAsync(Func<Task<ApiResponse<ReservationDetailResponse>>> save, string doneMessage)
    {
        isBusy = true;
        actionError = null;

        ApiResponse<ReservationDetailResponse> response = await save();

        isBusy = false;
        if (!response.Succeeded || response.Value is null)
        {
            actionError = response.Message ?? "Opslaan is niet gelukt. Probeer het opnieuw.";
            return;
        }

        reservation = response.Value;
        mode = Mode.View;
        successMessage = doneMessage;
    }

    private void CloseAction()
    {
        mode = Mode.View;
        actionError = null;
    }

    private void ClearMessages()
    {
        actionError = null;
        successMessage = null;
        cancelQuote = null;
    }
}
