@page "/beheer/onderhoud"
@attribute [Authorize(Roles = Roles.Staff)]
@using Vakantiepark.Shared.DTOs.Maintenance
@inject IMaintenanceService MaintenanceService
@inject TimeProvider TimeProvider

<PageTitle>Niet verhuurbaar | Vakantiepark D'r op Uut</PageTitle>

<section class="page-head">
    <div class="container">
        <div class="eyebrow">Beheeromgeving</div>
        <h1 class="page-title mt-2">Tijdelijk niet verhuurbaar</h1>
        <p class="page-intro mt-4">
            Zet een accommodatie buiten gebruik voor onderhoud of een storing. In die periode is de eenheid niet te vinden en niet te boeken.
        </p>
        <a class="btn btn-du-light mt-3" href="beheer">Terug naar beheer</a>
    </div>
</section>

<section class="section-pad">
    <div class="container">
        <div class="detail-meta-card p-3">
            <div class="row align-items-center g-2">
                <div class="col-12 col-md-4 col-lg-3">
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-label fw-semibold mb-0" for="maintenance-unit">Accommodatie</label>
                    </div>
                </div>
                <div class="col-12 col-md-8 col-lg-9">
                    <select id="maintenance-unit" class="form-select" @bind="SelectedUnitCode" @bind:after="LoadOverviewAsync" disabled="@(units.Count == 0)">
                        <option value="">Kies een accommodatie</option>
                        @foreach (IGrouping<string, AccommodationResponse> group in units.GroupBy(unit => unit.TypeName))
                        {
                            <optgroup label="@group.Key">
                                @foreach (AccommodationResponse unit in group)
                                {
                                    <option value="@unit.Code">@unit.Code · @unit.Name (@unit.Zone)</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-4 d-flex justify-content-between align-items-center gap-3" role="alert">
                <span>@errorMessage</span>
                <button type="button" class="btn-close" aria-label="Sluiten" @onclick="DismissError"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success mt-4 d-flex justify-content-between align-items-center gap-3" role="status">
                <span>@successMessage</span>
                <button type="button" class="btn-close" aria-label="Sluiten" @onclick="DismissSuccess"></button>
            </div>
        }

        @if (overview is not null)
        {
            <div class="row g-3 mt-1">
                <div class="col-12 col-xl-4">
                    <div class="detail-meta-card h-100 p-3">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                            <div>
                                <h2 class="section-title h4 mb-1">Periode toevoegen</h2>
                                <p class="small text-muted-du mb-0">@overview.UnitCode · @overview.UnitName</p>
                            </div>
                        </div>

                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label fw-semibold" for="maintenance-start">Van</label>
                                <input id="maintenance-start" type="date" class="form-control" @bind="newStartDate" min="@Today.ToString("yyyy-MM-dd")" disabled="@hasPendingConfirmation" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold" for="maintenance-end">Tot en met</label>
                                <input id="maintenance-end" type="date" class="form-control" @bind="newEndDate" min="@newStartDate.ToString("yyyy-MM-dd")" disabled="@hasPendingConfirmation" />
                            </div>
                            <div class="col-12 col-sm-6 col-xl-12">
                                <label class="form-label fw-semibold" for="maintenance-reason">Reden</label>
                                <select id="maintenance-reason" class="form-select" @bind="newReason" disabled="@hasPendingConfirmation">
                                    @foreach (KeyValuePair<string, string> reason in ReasonLabels)
                                    {
                                        <option value="@reason.Key">@reason.Value</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-sm-6 col-xl-12">
                                <label class="form-label fw-semibold" for="maintenance-note">
                                    Toelichting @(newReason == "Other" ? "(verplicht)" : "(optioneel)")
                                </label>
                                <textarea id="maintenance-note" class="form-control" rows="3" maxlength="300" @bind="newNote" disabled="@hasPendingConfirmation"></textarea>
                            </div>
                        </div>

                        @if (hasPendingConfirmation)
                        {
                            <div class="alert alert-warning mt-4 mb-0" role="alert">
                                <strong>@pendingMessage</strong>
                                <ul class="mt-2 mb-3">
                                    @foreach (BookingConflictResponse booking in pendingConflicts)
                                    {
                                        <li>@BookingLine(booking)</li>
                                    }
                                </ul>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" id="maintenance-confirm" class="btn btn-du" @onclick="() => CreateAsync(true)" disabled="@isBusy">Bevestigen en vastleggen</button>
                                    <button type="button" class="btn btn-du-light" @onclick="CancelConfirmation" disabled="@isBusy">Annuleren</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button type="button" id="maintenance-save" class="btn btn-du w-100 mt-3 py-2" @onclick="() => CreateAsync(false)" disabled="@isBusy">
                                Buiten gebruik zetten
                            </button>
                        }
                    </div>
                </div>

                <div class="col-12 col-xl-8">
                    <div class="detail-meta-card h-100 p-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <div>
                                <div class="small text-uppercase text-muted fw-semibold">Overzicht</div>
                                <h2 class="section-title h4 mb-1">Periodes</h2>
                                <p class="small text-muted-du mb-0">Historie en geplande blokkades</p>
                            </div>

                            @if (overview.Periods.Count > 0)
                            {
                                <div class="d-flex flex-wrap gap-1" role="group" aria-label="Filter periodes">
                                    @foreach (KeyValuePair<string, string> filter in PeriodFilters)
                                    {
                                        <button type="button"
                                                    class="btn btn-sm px-2 py-1 @(periodFilter == filter.Key ? "btn-du" : "btn-du-light")"
                                                aria-pressed="@(periodFilter == filter.Key ? "true" : "false")"
                                                @onclick="() => periodFilter = filter.Key">
                                            @filter.Value (@overview.Periods.Count(period => MatchesFilter(period, filter.Key)))
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        @if (overview.Periods.Count == 0)
                        {
                            <p class="text-muted-du mb-0">Deze accommodatie heeft geen onderhoudsperiodes en is nu overal te boeken.</p>
                        }
                        else
                        {
                            @if (VisiblePeriods.Count == 0)
                            {
                                <p class="text-muted-du mb-0">Geen periodes voor dit filter.</p>
                            }
                        }

                        @foreach (MaintenancePeriodResponse period in VisiblePeriods)
                        {
                            <article class="info-block h-auto mb-2 p-3">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="fw-bold text-success">@PeriodDates(period.StartDate, period.EndDate)</div>
                                        <div class="small text-muted-du">@ReasonLabel(period.Reason)@(string.IsNullOrWhiteSpace(period.Note) ? "" : $" · {period.Note}")</div>
                                    </div>
                                    <span class="badge rounded-pill align-self-start @StatusBadgeClass(period)">@StatusLabel(period)</span>
                                </div>

                                @if (period.ConflictingBookings.Count > 0)
                                {
                                    <div class="border-start border-3 border-danger ps-3 mt-3 text-danger">
                                        <div class="small fw-semibold">Actie nodig: @period.ConflictingBookings.Count boeking(en) in deze periode</div>
                                        <ul class="small mb-0">
                                            @foreach (BookingConflictResponse booking in period.ConflictingBookings)
                                            {
                                                <li>@BookingLine(booking)</li>
                                            }
                                        </ul>
                                    </div>
                                }

                                @if (period.EndDate >= Today)
                                {
                                    <div class="d-grid d-sm-flex gap-2 mt-3 pt-3 border-top">
                                        <button type="button"
                                                class="btn btn-sm btn-du-light flex-sm-fill"
                                                aria-expanded="@(editingPeriodId == period.Id ? "true" : "false")"
                                                @onclick="() => ToggleEditing(period)" disabled="@isBusy">
                                            Inkorten of verlengen
                                        </button>
                                        @if (period.StartDate <= Today)
                                        {
                                            <button type="button" class="btn btn-sm btn-du" @onclick="() => AskToEnd(period)" disabled="@isBusy">Vandaag beëindigen</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-du-light text-danger" @onclick="() => AskToEnd(period)" disabled="@isBusy">Periode annuleren</button>
                                        }
                                    </div>

                                    @if (editingPeriodId == period.Id)
                                    {
                                        <div class="row g-2 mt-2 align-items-end">
                                            <div class="col-6 col-md-4">
                                                <label class="form-label small fw-semibold" for="edit-start-@period.Id">Van</label>
                                                <input id="edit-start-@period.Id" type="date" class="form-control" @bind="editStartDate"
                                                       min="@Today.ToString("yyyy-MM-dd")" disabled="@(period.StartDate <= Today)" />
                                            </div>
                                            <div class="col-6 col-md-4">
                                                <label class="form-label small fw-semibold" for="edit-end-@period.Id">Tot en met</label>
                                                <input id="edit-end-@period.Id" type="date" class="form-control" @bind="editEndDate"
                                                       min="@EditEndMin" />
                                            </div>
                                            <div class="col-12 col-md-4 d-flex gap-2">
                                                <button type="button" class="btn btn-du" @onclick="() => AskToConfirmUpdate(period, editStartDate, editEndDate)" disabled="@isBusy">Opslaan</button>
                                                <button type="button" class="btn btn-du-light" @onclick="() => editingPeriodId = null" disabled="@isBusy">Annuleren</button>
                                            </div>
                                            @if (period.StartDate <= Today)
                                            {
                                                <div class="col-12 small text-muted-du">De periode loopt al, daarom kan alleen de einddatum nog worden aangepast.</div>
                                            }
                                        </div>
                                    }
                                }
                            </article>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@if (pendingUpdate is not null)
{
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="confirm-update-title"
         @onkeydown="OnModalKeyAsync">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 id="confirm-update-title" class="modal-title h5">@UpdateTitle(pendingUpdate)</h2>
                    <button type="button" class="btn-close" aria-label="Sluiten" @onclick="CancelUpdate" disabled="@isBusy"></button>
                </div>
                <div class="modal-body">
                    @if (pendingUpdate.Kind == UpdateKind.End)
                    {
                        <p>Weet je zeker dat <strong>@SelectedUnitCode</strong> klaar is?</p>
                        <p class="mb-0 text-muted-du">De periode blijft zichtbaar als afgelopen. De accommodatie is vanaf vandaag (@Today.ToString("d MMM yyyy")) weer te vinden en te boeken.</p>
                    }
                    else if (pendingUpdate.Kind == UpdateKind.Cancel)
                    {
                        <p>Weet je zeker dat je de periode van <strong>@SelectedUnitCode</strong> van <strong>@PeriodDates(pendingUpdate.StartDate, pendingUpdate.EndDate)</strong> wilt annuleren?</p>
                        <p class="mb-0 text-muted-du">De accommodatie is meteen weer te vinden en te boeken in die dagen.</p>
                    }
                    else
                    {
                        <p>
                            Weet je zeker dat je de periode van <strong>@SelectedUnitCode</strong> wilt aanpassen naar
                            <strong>@PeriodDates(pendingUpdate.StartDate, pendingUpdate.EndDate)</strong>?
                        </p>
                        @if (pendingUpdate.EndDate < pendingUpdate.OldEndDate)
                        {
                            <p class="mb-0 text-muted-du">Vanaf @pendingUpdate.EndDate.AddDays(1).ToString("d MMM yyyy") is de accommodatie weer te vinden en te boeken.</p>
                        }
                        else if (pendingUpdate.EndDate > pendingUpdate.OldEndDate)
                        {
                            <p class="mb-0 text-muted-du">Tot en met @pendingUpdate.EndDate.ToString("d MMM yyyy") is de accommodatie niet te vinden en niet te boeken.</p>
                        }
                    }

                    @if (pendingUpdate.NewConflicts.Count > 0)
                    {
                        <div class="alert alert-warning mt-3 mb-0" role="alert">
                            <strong>@pendingUpdate.ConflictMessage</strong>
                            <ul class="mt-2 mb-0">
                                @foreach (BookingConflictResponse booking in pendingUpdate.NewConflicts)
                                {
                                    <li>@BookingLine(booking)</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-du-light" @onclick="CancelUpdate" disabled="@isBusy">Terug</button>
                    <button type="button" id="confirm-update" class="btn btn-du" @ref=confirmButton @onclick="ConfirmUpdateAsync" disabled="@isBusy">
                        @ConfirmLabel(pendingUpdate)
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    private static readonly Dictionary<string, string> ReasonLabels = new()
    {
        ["Maintenance"] = "Onderhoud",
        ["TechnicalProblem"] = "Technisch probleem",
        ["Other"] = "Overig",
    };

    private static readonly Dictionary<string, string> PeriodFilters = new()
    {
        ["all"] = "Alle",
        ["active"] = "Nu buiten gebruik",
        ["planned"] = "Gepland",
        ["ended"] = "Afgelopen",
        ["action"] = "Actie nodig",
    };

    // Same "today" as the API (UTC via TimeProvider)
    private DateOnly Today => DateOnly.FromDateTime(TimeProvider.GetUtcNow().UtcDateTime);

    private List<AccommodationResponse> units = [];
    private MaintenanceUnitOverviewResponse? overview;
    private string SelectedUnitCode = string.Empty;

    private DateOnly newStartDate;
    private DateOnly newEndDate;
    private string newReason = "Maintenance";
    private string? newNote;

    private bool hasPendingConfirmation;
    private string? pendingMessage;
    private List<BookingConflictResponse> pendingConflicts = [];

    private Guid? editingPeriodId;
    private DateOnly editStartDate;
    private DateOnly editEndDate;
    private PendingUpdate? pendingUpdate;
    private string periodFilter = "all";

    private List<MaintenancePeriodResponse> VisiblePeriods
        => (overview?.Periods ?? []).Where(period => MatchesFilter(period, periodFilter)).ToList();

    // The new end date may not lie before the start or in the past.
    private string EditEndMin
        => (editStartDate > Today ? editStartDate : Today).ToString("yyyy-MM-dd");

    private bool isBusy;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        newStartDate = Today;
        newEndDate = Today;

        ApiResponse<List<AccommodationResponse>> response = await MaintenanceService.GetUnitsAsync();
        if (response.Succeeded && response.Value is not null)
            units = response.Value.OrderBy(unit => unit.TypeName).ThenBy(unit => unit.Code).ToList();
        else
            errorMessage = response.Message ?? "De accommodaties konden niet worden geladen.";
    }

    private async Task LoadOverviewAsync()
    {
        overview = null;
        editingPeriodId = null;
        CancelConfirmation();
        errorMessage = null;
        successMessage = null;

        if (string.IsNullOrEmpty(SelectedUnitCode))
            return;

        await RefreshOverviewAsync();
    }

    private async Task RefreshOverviewAsync()
    {
        ApiResponse<MaintenanceUnitOverviewResponse> response = await MaintenanceService.GetOverviewAsync(SelectedUnitCode);
        if (response.Succeeded && response.Value is not null)
            overview = response.Value;
        else
            errorMessage = response.Message ?? "De periodes konden niet worden geladen.";
    }

    // First call without confirmation; the API answers with the overlapping bookings when the
    // staff has to confirm them explicitly (criterion 3). The second call sends the confirmation.
    private async Task CreateAsync(bool confirmExistingBookings)
    {
        isBusy = true;
        errorMessage = null;
        successMessage = null;

        ApiResponse<MaintenancePeriodSaveResult> response = await MaintenanceService.CreateAsync(new CreateMaintenancePeriodRequest
        {
            AccommodationUnitCode = SelectedUnitCode,
            StartDate = newStartDate,
            EndDate = newEndDate,
            Reason = newReason,
            Note = newNote,
            ConfirmExistingBookings = confirmExistingBookings,
        });

        if (!response.Succeeded || response.Value is null)
        {
            errorMessage = response.Message ?? "De periode kon niet worden vastgelegd.";
        }
        else if (response.Value.RequiresConfirmation)
        {
            hasPendingConfirmation = true;
            pendingMessage = response.Value.Message;
            pendingConflicts = response.Value.ConflictingBookings;
        }
        else
        {
            CancelConfirmation();
            successMessage = $"{SelectedUnitCode} is niet verhuurbaar van {PeriodDates(newStartDate, newEndDate)}.";
            newNote = null;
            await RefreshOverviewAsync();
        }

        isBusy = false;
    }

    private void CancelConfirmation()
    {
        hasPendingConfirmation = false;
        pendingMessage = null;
        pendingConflicts = [];
    }

    private void ToggleEditing(MaintenancePeriodResponse period)
    {
        if (editingPeriodId == period.Id)
        {
            editingPeriodId = null;
            return;
        }

        editingPeriodId = period.Id;
        editStartDate = period.StartDate;
        editEndDate = period.EndDate;
    }

    // Ending runs through its own API action: a running period then frees the unit from today,
    // a planned one is cancelled. It closes an open edit row so the two never mix.
    private void AskToEnd(MaintenancePeriodResponse period)
    {
        editingPeriodId = null;
        UpdateKind kind = period.StartDate <= Today ? UpdateKind.End : UpdateKind.Cancel;
        pendingUpdate = new PendingUpdate(period.Id, period.StartDate, period.EndDate, period.EndDate, kind);
    }

    // Changing a period frees or blocks the unit for guests, so the staff confirms the new dates first.
    private void AskToConfirmUpdate(MaintenancePeriodResponse period, DateOnly startDate, DateOnly endDate)
        => pendingUpdate = new PendingUpdate(period.Id, startDate, endDate, period.EndDate, UpdateKind.Change);

    private void CancelUpdate()
        => pendingUpdate = null;

    private void DismissError()
        => errorMessage = null;

    private void DismissSuccess()
        => successMessage = null;

    private ElementReference confirmButton;
    private bool modalFocused;

    // Escape closes the popup, as it does in a Bootstrap dialog. The dialog takes focus when it
    // opens, so keyboard users land straight on the confirmation buttons.
    private async Task OnModalKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && !isBusy)
        {
            CancelUpdate();
            modalFocused = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingUpdate is not null && !modalFocused)
        {
            await confirmButton.FocusAsync();
            modalFocused = true;
        }
        else if (pendingUpdate is null)
        {
            modalFocused = false;
        }
    }

    // The first confirmation sends the change; when the API reports bookings in added days, the
    // dialog lists them and the second confirmation sends them as confirmed (criterion 3).
    private async Task ConfirmUpdateAsync()
    {
        if (pendingUpdate is null)
            return;

        PendingUpdate update = pendingUpdate;
        isBusy = true;
        errorMessage = null;
        successMessage = null;

        if (update.Kind != UpdateKind.Change)
        {
            await EndAsync(update);
            isBusy = false;
            return;
        }

        ApiResponse<MaintenancePeriodSaveResult> response = await MaintenanceService.UpdateAsync(update.Id, new UpdateMaintenancePeriodRequest
        {
            StartDate = update.StartDate,
            EndDate = update.EndDate,
            ConfirmExistingBookings = update.NewConflicts.Count > 0,
        });

        if (!response.Succeeded || response.Value is null)
        {
            pendingUpdate = null;
            errorMessage = response.Message ?? "De periode kon niet worden aangepast.";
        }
        else if (response.Value.RequiresConfirmation)
        {
            pendingUpdate = update with { NewConflicts = response.Value.ConflictingBookings, ConflictMessage = response.Value.Message };
        }
        else
        {
            pendingUpdate = null;
            editingPeriodId = null;
            successMessage = $"De periode is aangepast naar {PeriodDates(update.StartDate, update.EndDate)}.";
            await RefreshOverviewAsync();
        }

        isBusy = false;
    }

    private async Task EndAsync(PendingUpdate update)
    {
        ApiResponse<object> response = await MaintenanceService.EndAsync(update.Id);
        pendingUpdate = null;

        if (!response.Succeeded)
        {
            errorMessage = response.Message ?? "De periode kon niet worden beëindigd.";
            return;
        }

        successMessage = update.Kind == UpdateKind.End
            ? $"De periode is beëindigd; {SelectedUnitCode} is vanaf vandaag weer te boeken."
            : $"De periode van {PeriodDates(update.StartDate, update.EndDate)} is geannuleerd.";
        await RefreshOverviewAsync();
    }

    private static string UpdateTitle(PendingUpdate update)
    {
        if (update.Kind == UpdateKind.End)
            return "Periode nu beëindigen?";

        if (update.Kind == UpdateKind.Cancel)
            return "Periode annuleren?";

        if (update.EndDate < update.OldEndDate)
            return "Periode inkorten?";

        return update.EndDate > update.OldEndDate ? "Periode verlengen?" : "Periode aanpassen?";
    }

    private static string ConfirmLabel(PendingUpdate update) => update.Kind switch
    {
        UpdateKind.End => "Ja, beëindigen",
        UpdateKind.Cancel => "Ja, annuleren",
        _ => update.NewConflicts.Count > 0 ? "Bevestigen en aanpassen" : "Ja, aanpassen",
    };

    private bool MatchesFilter(MaintenancePeriodResponse period, string filter) => filter switch
    {
        "action" => period.ConflictingBookings.Count > 0,
        "all" => true,
        _ => StatusKey(period) == filter,
    };

    private static string ReasonLabel(string reason)
        => ReasonLabels.TryGetValue(reason, out string? label) ? label : reason;

    private string StatusKey(MaintenancePeriodResponse period)
        => period.EndDate < Today ? "ended" : period.StartDate > Today ? "planned" : "active";

    private string StatusLabel(MaintenancePeriodResponse period) => StatusKey(period) switch
    {
        "ended" => "Afgelopen",
        "planned" => "Gepland",
        _ => "Nu buiten gebruik",
    };

    private string StatusBadgeClass(MaintenancePeriodResponse period) => StatusKey(period) switch
    {
        "ended" => "text-bg-secondary",
        "planned" => "text-bg-warning",
        _ => "text-bg-danger",
    };

    private static string PeriodDates(DateOnly startDate, DateOnly endDate)
        => $"{startDate:d MMM yyyy} t/m {endDate:d MMM yyyy}";

    private static string BookingLine(BookingConflictResponse booking)
        => $"{booking.BookingNumber} · {booking.Name} · {booking.ArrivalDate:d MMM} – {booking.DepartureDate:d MMM yyyy} · {(booking.NumberOfGuests == 1 ? "1 persoon" : $"{booking.NumberOfGuests} personen")}";

    private enum UpdateKind { Change, End, Cancel }

    private sealed record PendingUpdate(Guid Id, DateOnly StartDate, DateOnly EndDate, DateOnly OldEndDate, UpdateKind Kind)
    {
        public List<BookingConflictResponse> NewConflicts { get; init; } = [];
        public string? ConflictMessage { get; init; }
    }
}
