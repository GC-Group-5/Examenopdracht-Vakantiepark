@page "/beheer/schoonmaak"
@attribute [Authorize(Roles = Roles.Schoonmaker)]
@inject NavigationManager NavigationManager
@inject IAuthService AuthService

<PageTitle>Schoonmaakbeheer | Vakantiepark D'r op Uut</PageTitle>

<section class="page-head">
    <div class="container">
        <div class="eyebrow">Schoonmaakbeheer</div>
        <AuthorizeView Context="auth">
            <h1 class="page-title mt-2">Hallo, @auth.User.Identity?.Name</h1>
            <p class="page-intro mt-4">
                Je bent ingelogd als <strong>@Roles.Schoonmaker</strong>.
            </p>
        </AuthorizeView>
        <button type="button" class="btn btn-du-light mt-3" @onclick="LogoutAsync">Uitloggen</button>
    </div>
</section>

<section class="section-pad">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6 col-xl-4"><div class="info-block"><strong>Vertrekken per dag</strong><div class="small text-muted-du">Welke accommodaties leegkomen en schoongemaakt moeten worden (US-32).</div></div></div>
        </div>
    </div>
</section>

@code {
    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("");
    }
}
