@page "/beheer/inloggen"
@inject NavigationManager NavigationManager
@inject IAuthService AuthService

<PageTitle>Inloggen medewerkers | Vakantiepark D'r op Uut</PageTitle>

<section class="login-page">
    <div class="container">
        <div class="row align-items-center justify-content-center g-5 py-5">
            @* The photo only fits next to the form; on a phone the form comes first and alone. *@
            <div class="col-lg-6 d-none d-lg-block">
                <div class="login-photo">
                    <img src="img/accommodaties/bosvilla-10/1.webp" alt="Bosvilla 10 met rieten dak tussen de bomen" />
                    <div class="login-photo-note">
                        <div class="eyebrow">Beheeromgeving</div>
                        <p class="login-photo-text">Reserveringen, aankomsten en schoonmaak van @ParkInfo.Name op één plek.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-8 col-lg-5 col-xl-4 offset-xl-1">
                <div class="login-card">
                    @if (!awaitingCode)
                    {
                        <div class="eyebrow">Beheeromgeving</div>
                        <h1 class="login-title">Welkom terug</h1>
                        <p class="text-muted-du mb-4">Log in met je werkaccount van @ParkInfo.Name.</p>

                        @if (errorMessage is not null)
                        {
                            <div class="alert alert-danger" role="alert">@errorMessage</div>
                        }

                        <EditForm Model="request" OnValidSubmit="LoginAsync">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="login-email">E-mailadres</label>
                                <InputText id="login-email" type="email" class="form-control" @bind-Value="request.Email" autocomplete="username" />
                                <ValidationMessage For="() => request.Email" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="login-password">Wachtwoord</label>
                                <div class="login-password">
                                    <InputText id="login-password" type="@(showPassword ? "text" : "password")" class="form-control" @bind-Value="request.Password" autocomplete="current-password" />
                                    <button type="button" class="login-password-toggle" @onclick="TogglePassword"
                                            aria-label="@(showPassword ? "Wachtwoord verbergen" : "Wachtwoord tonen")" aria-pressed="@showPassword">
                                        @if (showPassword)
                                        {
                                            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M3 3l18 18M10.6 5.1A10 10 0 0 1 12 5c6 0 10 7 10 7a17 17 0 0 1-3.2 3.9M6.6 6.6C3.9 8.4 2 12 2 12s4 7 10 7a9.6 9.6 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2" /></svg>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                                        }
                                    </button>
                                </div>
                                <ValidationMessage For="() => request.Password" />
                            </div>

                            <label class="check-field mb-4" for="login-remember">
                                <InputCheckbox id="login-remember" class="form-check-input" @bind-Value="rememberMe" />
                                <span>
                                    Onthoud mij op dit apparaat
                                    <span class="d-block small text-muted-du">Niet aanvinken op een gedeelde computer.</span>
                                </span>
                            </label>

                            <button type="submit" class="btn btn-du w-100" disabled="@isBusy">
                                @(isBusy ? "Bezig met inloggen…" : "Inloggen")
                            </button>
                        </EditForm>

                        <p class="login-help">
                            Wachtwoord vergeten? Vraag een beheerder om je account opnieuw in te stellen.
                        </p>
                    }
                    else
                    {
                        <div class="login-mail-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="28" height="28"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M3 6h18v12H3zM3 6l9 7 9-7" /></svg>
                        </div>
                        <div class="eyebrow">Stap 2 van 2</div>
                        <h1 class="login-title">Check je e-mail</h1>
                        <p class="text-muted-du mb-4">We hebben een code van 6 cijfers gestuurd naar <strong class="text-break">@codeRequest.Email</strong>.</p>

                        @if (errorMessage is not null)
                        {
                            <div class="alert alert-danger" role="alert">@errorMessage</div>
                        }

                        <EditForm Model="codeRequest" OnValidSubmit="VerifyCodeAsync">
                            <DataAnnotationsValidator />

                            <div class="mb-4">
                                <label class="form-label fw-semibold" for="login-code">Code</label>
                                <InputText id="login-code" class="form-control login-code" @bind-Value="codeRequest.Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000" />
                                <ValidationMessage For="() => codeRequest.Code" />
                            </div>

                            <button type="submit" class="btn btn-du w-100" disabled="@isBusy">
                                @(isBusy ? "Bezig met controleren…" : "Bevestigen")
                            </button>
                        </EditForm>

                        <p class="login-help">
                            Geen e-mail gekregen? Kijk in je spam of
                            <button type="button" class="btn btn-link p-0 align-baseline login-link" @onclick="StartOver">log opnieuw in</button>
                            voor een nieuwe code.
                        </p>
                    }
                </div>

                <p class="text-center small text-muted-du mt-4 mb-0">
                    Gast van het park? <a href="mijn-boeking" class="fw-semibold">Bekijk je boeking</a>
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private const string CleanerPage = "beheer/schoonmaak";
    private const string FailedMessage = "Inloggen is niet gelukt.";

    private readonly LoginRequest request = new LoginRequest();
    private VerifyLoginCodeRequest codeRequest = new VerifyLoginCodeRequest();
    private string? errorMessage;
    private bool isBusy;
    private bool awaitingCode;
    private bool rememberMe;
    private bool showPassword;

    private async Task LoginAsync()
    {
        isBusy = true;
        errorMessage = null;

        ApiResponse<LoginResponse> response = await AuthService.LoginAsync(request, rememberMe);

        isBusy = false;
        request.Password = string.Empty;
        showPassword = false;
        if (!response.Succeeded || response.Value is null)
        {
            errorMessage = response.Message ?? FailedMessage;
            return;
        }

        if (response.Value.RequiresCode)
        {
            codeRequest = new VerifyLoginCodeRequest() { Email = request.Email, RememberDevice = rememberMe };
            awaitingCode = true;
            return;
        }

        Finish(response.Value);
    }

    private async Task VerifyCodeAsync()
    {
        isBusy = true;
        errorMessage = null;

        ApiResponse<LoginResponse> response = await AuthService.VerifyLoginCodeAsync(codeRequest);

        isBusy = false;
        if (!response.Succeeded || response.Value is null)
        {
            errorMessage = response.Message ?? FailedMessage;
            codeRequest.Code = string.Empty;
            return;
        }

        Finish(response.Value);
    }

    private void TogglePassword()
        => showPassword = !showPassword;

    private void StartOver()
    {
        awaitingCode = false;
        errorMessage = null;
    }

    private void Finish(LoginResponse response)
    {
        if (response.Token is null)
        {
            errorMessage = FailedMessage;
            return;
        }

        NavigationManager.NavigateTo(GetRedirectUrl(response.Token));
    }

    // Only redirect within this site, so a link with a foreign returnUrl can't send someone to another website.
    private string GetSafeReturnUrl()
    {
        if (string.IsNullOrWhiteSpace(ReturnUrl) || !ReturnUrl.StartsWith('/') || ReturnUrl.StartsWith("//") || ReturnUrl.StartsWith("/\\"))
            return "beheer";

        return ReturnUrl.TrimStart('/');
    }

    // A cleaner only has their own page; staff go back to where they were heading.
    private string GetRedirectUrl(TokenResponse token)
        => token.Role == Roles.Schoonmaker ? CleanerPage : GetSafeReturnUrl();
}
