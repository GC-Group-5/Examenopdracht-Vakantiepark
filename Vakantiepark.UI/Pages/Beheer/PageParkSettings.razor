@page "/beheer/instellingen"
@page "/beheer/instellingen/{Tab}"
@attribute [Authorize(Roles = Roles.Beheerder)]
@using Vakantiepark.Shared.DTOs.Park
@inject IParkSettingsService ParkSettingsService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>@ActiveTabTitle | Parkinstellingen | Vakantiepark D'r op Uut</PageTitle>

<section class="page-head">
    <div class="container">
        <div class="eyebrow">Beheeromgeving</div>
        <h1 class="page-title mt-2">Parkinstellingen</h1>
        <p class="page-intro mt-3 mb-0">Wijzigingen gelden direct voor nieuwe zoekopdrachten en boekingen. Bestaande boekingen houden hun prijs en tijden.</p>
        <a class="btn btn-du-light mt-3" href="beheer">Terug naar beheer</a>
    </div>
</section>

<section class="section-pad">
    <div class="container">
        <nav class="nav nav-tabs nav-fill flex-wrap mb-4" aria-label="Onderdelen van de parkinstellingen">
            @foreach ((string slug, string title, string description) in Tabs)
            {
                <a class="nav-link @(slug == ActiveTab ? "active" : null)" href="@($"beheer/instellingen/{slug}")" aria-current="@(slug == ActiveTab ? "page" : null)" @onclick="() => NavigateToTabAsync(slug)" @onclick:preventDefault="true">
                    <span class="d-block">@title</span>
                    <span class="small fw-normal d-none d-lg-block">@description</span>
                </a>
            }
        </nav>

        @if (message is not null)
        {
            <div class="alert @(succeeded ? "alert-success" : "alert-danger") sticky-top d-flex justify-content-between align-items-center gap-3" role="status">
                <span>@message</span>
                <button type="button" class="btn-close" aria-label="Sluiten" @onclick="() => message = null"></button>
            </div>
        }

        @if (settings is null && loadError is null)
        {
            <div class="p-4 border rounded-4 bg-white shadow-sm" role="status">De instellingen worden opgehaald…</div>
        }
        else if (loadError is not null)
        {
            <div class="alert alert-danger" role="alert">@loadError</div>
        }
        else if (ActiveTab == RulesTab)
        {
            <EditForm Model="settings!.Rules" OnValidSubmit="() => SaveAsync(() => ParkSettingsService.UpdateAsync(settings.Rules))">
                <DataAnnotationsValidator />
                <div class="row g-4">
                    <div class="col-lg-6">
                        <fieldset class="p-4 border rounded-4 bg-white h-100">
                            <legend class="h5 float-none">Aankomst en vertrek</legend>
                            <p class="small text-muted-du">Omdat gasten voor de vertrektijd weg zijn, mag een vertrekdag ook een aankomstdag zijn.</p>
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <label class="form-label" for="arrival-time">Aankomst vanaf</label>
                                    <input id="arrival-time" type="text" class="form-control" placeholder="uu:mm" @bind="settings.Rules.ArrivalTime" @bind:format="HH:mm" />
                                    <ValidationMessage For="() => settings.Rules.ArrivalTime" />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label" for="departure-time">Vertrek voor</label>
                                    <input id="departure-time" type="text" class="form-control" placeholder="uu:mm" @bind="settings.Rules.DepartureTime" @bind:format="HH:mm" />
                                    <ValidationMessage For="() => settings.Rules.DepartureTime" />
                                </div>
                            </div>
                        </fieldset>
                    </div>
                    <div class="col-lg-6">
                        <fieldset class="p-4 border rounded-4 bg-white h-100">
                            <legend class="h5 float-none">Verblijf en extra kosten</legend>
                            <p class="small text-muted-du">Het minimum geldt voor boekingen met een nacht in een hoogseizoen.</p>
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <label class="form-label" for="minimum-nights">Minimum verblijf hoogseizoen</label>
                                    <div class="input-group">
                                        <InputNumber id="minimum-nights" class="form-control" @bind-Value="settings.Rules.HighSeasonMinimumNights" />
                                        <span class="input-group-text">nachten</span>
                                    </div>
                                    <ValidationMessage For="() => settings.Rules.HighSeasonMinimumNights" />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label" for="pet-fee">Schoonmaakkosten huisdieren</label>
                                    <div class="input-group">
                                        <span class="input-group-text">€</span>
                                        <InputNumber id="pet-fee" class="form-control" step="0.01" @bind-Value="settings.Rules.PetCleaningFee" />
                                    </div>
                                    <ValidationMessage For="() => settings.Rules.PetCleaningFee" />
                                </div>
                            </div>
                        </fieldset>
                    </div>
                    <div class="col-12">
                        <fieldset class="p-4 border rounded-4 bg-white">
                            <legend class="h5 float-none">Betalen en annuleren</legend>
                            <p class="small text-muted-du">De aanbetaling en de borg worden bij de receptie voldaan; de borg krijgt de gast terug bij vertrek. Tussen beide annuleringsgrenzen krijgt de gast een deel terug.</p>
                            <div class="row g-3">
                                <div class="col-md-6 col-xl-3">
                                    <label class="form-label" for="deposit">Aanbetaling</label>
                                    <div class="input-group">
                                        <InputNumber id="deposit" class="form-control" step="0.01" @bind-Value="settings.Rules.DepositPercentage" />
                                        <span class="input-group-text">%</span>
                                    </div>
                                    <ValidationMessage For="() => settings.Rules.DepositPercentage" />
                                </div>
                                <div class="col-md-6 col-xl-3">
                                    <label class="form-label" for="security-deposit">Borg</label>
                                    <div class="input-group">
                                        <span class="input-group-text">€</span>
                                        <InputNumber id="security-deposit" class="form-control" step="0.01" @bind-Value="settings.Rules.SecurityDeposit" />
                                    </div>
                                    <ValidationMessage For="() => settings.Rules.SecurityDeposit" />
                                </div>
                                <div class="col-md-6 col-xl-3">
                                    <label class="form-label" for="free-cancellation">Gratis annuleren tot</label>
                                    <div class="input-group">
                                        <InputNumber id="free-cancellation" class="form-control" @bind-Value="settings.Rules.FreeCancellationDaysBeforeArrival" />
                                        <span class="input-group-text">dagen voor aankomst</span>
                                    </div>
                                    <ValidationMessage For="() => settings.Rules.FreeCancellationDaysBeforeArrival" />
                                </div>
                                <div class="col-md-6 col-xl-3">
                                    <label class="form-label" for="no-refund">Geen terugbetaling binnen</label>
                                    <div class="input-group">
                                        <InputNumber id="no-refund" class="form-control" @bind-Value="settings.Rules.NoRefundDaysBeforeArrival" />
                                        <span class="input-group-text">dagen voor aankomst</span>
                                    </div>
                                    <ValidationMessage For="() => settings.Rules.NoRefundDaysBeforeArrival" />
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>
                <button type="submit" class="btn btn-du mt-4" disabled="@isBusy">Parkregels opslaan</button>
            </EditForm>
        }
        else if (ActiveTab == TaxTab)
        {
            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="p-4 border rounded-4 bg-white h-100">
                        <h2 class="h5">Tarieven</h2>
                        <p class="small text-muted-du">Een nieuw tarief geldt vanaf de ingangsdatum. Eerdere nachten houden het oude tarief.</p>
                        @if (settings!.TouristTaxRates.Count == 0)
                        {
                            <p class="mb-0">Er is nog geen tarief ingesteld.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead><tr><th>Ingangsdatum</th><th>Per persoon (12+) per nacht</th><th></th></tr></thead>
                                    <tbody>
                                        @foreach (AddTouristTaxRateRequest rate in settings.TouristTaxRates.OrderByDescending(taxRate => taxRate.ValidFrom))
                                        {
                                            <tr>
                                                <td>@rate.ValidFrom?.ToString(DateFormats.Date)</td>
                                                <td>€ @rate.AmountPerPersonPerNight?.ToString("0.00")</td>
                                                <td class="text-end"><span class="badge rounded-pill @RateStatusClass(rate)">@RateStatus(rate)</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="p-4 border rounded-4 bg-white h-100">
                        <h2 class="h5">Nieuw tarief toevoegen</h2>
                        <EditForm Model="newRate" OnValidSubmit="AddRateAsync">
                            <DataAnnotationsValidator />
                            <div class="mb-3">
                                <label class="form-label" for="rate-from">Ingangsdatum</label>
                                <InputDutchDate id="rate-from" class="form-control" @bind-Value="newRate.ValidFrom" />
                                <ValidationMessage For="() => newRate.ValidFrom" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="rate-amount">Bedrag per persoon per nacht</label>
                                <div class="input-group">
                                    <span class="input-group-text">€</span>
                                    <InputNumber id="rate-amount" class="form-control" step="0.01" @bind-Value="newRate.AmountPerPersonPerNight" />
                                </div>
                                <ValidationMessage For="() => newRate.AmountPerPersonPerNight" />
                            </div>
                            <button type="submit" class="btn btn-du" disabled="@isBusy">Tarief toevoegen</button>
                        </EditForm>
                    </div>
                </div>
            </div>
        }
        else if (ActiveTab == SeasonsTab)
        {
            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="p-4 border rounded-4 bg-white h-100">
                        <h2 class="h5">Seizoenen</h2>
                        <p class="small text-muted-du">Buiten een seizoen geldt de standaardprijs van een type.</p>
                        @if (settings!.Seasons.Count == 0)
                        {
                            <p class="mb-0">Er zijn nog geen seizoenen.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead><tr><th>Naam</th><th>Periode</th><th class="visually-hidden">Acties</th></tr></thead>
                                    <tbody>
                                        @foreach (SeasonResponse existing in settings.Seasons.OrderBy(candidate => candidate.StartDate))
                                        {
                                            <tr class="@(existing.Id == editingSeasonId ? "table-active" : null)">
                                                <td>
                                                    @existing.Name
                                                    @if (existing.IsHighSeason)
                                                    {
                                                        <span class="badge rounded-pill text-bg-warning ms-1">Hoogseizoen</span>
                                                    }
                                                </td>
                                                <td class="text-nowrap">@existing.StartDate?.ToString(DateFormats.Date) t/m @existing.EndDate?.ToString(DateFormats.Date)</td>
                                                <td class="text-end text-nowrap">
                                                    <button type="button" class="btn btn-du-light btn-sm" @onclick="() => EditSeason(existing)">Bewerken</button>
                                                    <button type="button" class="btn btn-du-danger btn-sm" @onclick="() => DeleteSeasonAsync(existing)" disabled="@isBusy">Verwijderen</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="p-4 border rounded-4 bg-white h-100 @(editingSeasonId is null ? null : "border-success")">
                        <h2 class="h5">@(editingSeasonId is null ? "Seizoen toevoegen" : "Seizoen bewerken")</h2>
                        <EditForm Model="season" OnValidSubmit="SaveSeasonAsync">
                            <DataAnnotationsValidator />
                            <div class="mb-3">
                                <label class="form-label" for="season-name">Naam</label>
                                <InputText id="season-name" class="form-control" @bind-Value="season.Name" />
                                <ValidationMessage For="() => season.Name" />
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col-sm-6">
                                    <label class="form-label" for="season-start">Van</label>
                                    <InputDutchDate id="season-start" class="form-control" @bind-Value="season.StartDate" RangeEnd="@season.EndDate" />
                                    <ValidationMessage For="() => season.StartDate" />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label" for="season-end">Tot en met</label>
                                    <InputDutchDate id="season-end" class="form-control" @bind-Value="season.EndDate" MinDate="@season.StartDate" RangeStart="@season.StartDate" />
                                    <ValidationMessage For="() => season.EndDate" />
                                </div>
                            </div>
                            <label class="check-field mb-3" for="season-high">
                                <InputCheckbox id="season-high" class="form-check-input" @bind-Value="season.IsHighSeason" />
                                Hoogseizoen (minimum verblijf geldt)
                            </label>
                            <button type="submit" class="btn btn-du" disabled="@isBusy">Seizoen opslaan</button>
                            @if (editingSeasonId is not null)
                            {
                                <button type="button" class="btn btn-du-light ms-2" @onclick="ResetSeason">Annuleren</button>
                            }
                        </EditForm>
                    </div>
                </div>
            </div>
        }
        else if (ActiveTab == PricesTab)
        {
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="p-4 border rounded-4 bg-white">
                        <h2 class="h5" id="type-list-title">Accommodatietypes</h2>
                        <div class="d-grid gap-2" role="group" aria-labelledby="type-list-title">
                            @foreach (TypePricesResponse type in settings!.Types)
                            {
                                <button type="button" class="btn @(type.Slug == SelectedType?.Slug ? "btn-du" : "btn-du-light") btn-sm d-flex justify-content-between align-items-center gap-2 text-start"
                                        aria-pressed="@(type.Slug == SelectedType?.Slug ? "true" : "false")" @onclick="() => selectedTypeSlug = type.Slug">
                                    <span>@type.Name</span>
                                    <span class="small text-nowrap">€ @type.DefaultPricePerNight?.ToString("0.00")</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-8">
                    @if (SelectedType is TypePricesResponse selected)
                    {
                        <div class="p-4 border rounded-4 bg-white">
                            <EditForm Model="selected" OnValidSubmit="() => SaveAsync(() => ParkSettingsService.UpdateTypePricesAsync(selected.Slug, selected))">
                                <DataAnnotationsValidator />
                                <h2 class="h5">@selected.Name</h2>
                                <p class="small text-muted-du">Prijzen per nacht. Een leeg seizoensveld betekent dat in dat seizoen de standaardprijs geldt.</p>

                                <h3 class="h6 mt-4">Basisprijzen</h3>
                                <div class="row g-3">
                                    <div class="col-sm-6">
                                        <label class="form-label" for="@($"{selected.Slug}-default")">Standaardprijs per nacht</label>
                                        <div class="input-group">
                                            <span class="input-group-text">€</span>
                                            <InputNumber id="@($"{selected.Slug}-default")" class="form-control" step="0.01" @bind-Value="selected.DefaultPricePerNight" />
                                        </div>
                                        <ValidationMessage For="() => selected.DefaultPricePerNight" />
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="form-label" for="@($"{selected.Slug}-cleaning")">Eindschoonmaak (eenmalig)</label>
                                        <div class="input-group">
                                            <span class="input-group-text">€</span>
                                            <InputNumber id="@($"{selected.Slug}-cleaning")" class="form-control" step="0.01" @bind-Value="selected.CleaningFee" />
                                        </div>
                                        <ValidationMessage For="() => selected.CleaningFee" />
                                    </div>
                                </div>

                                @if (selected.SeasonPrices.Count > 0)
                                {
                                    <h3 class="h6 mt-4">Seizoensprijzen per nacht</h3>
                                    <p class="small text-muted-du">Laat een seizoensprijs leeg om de standaardprijs van € @selected.DefaultPricePerNight?.ToString("0.00") te gebruiken.</p>
                                    <div class="row g-2 align-items-center mb-3">
                                        <div class="col-sm-5">
                                            <label class="visually-hidden" for="season-search">Zoek een seizoen</label>
                                            <input id="season-search" type="search" class="form-control" placeholder="Zoek op naam" @bind="seasonSearch" @bind:event="oninput" />
                                        </div>
                                        <div class="col-sm-4">
                                            <label class="visually-hidden" for="season-sort">Sorteren</label>
                                            <select id="season-sort" class="form-select" @bind="seasonSort">
                                                <option value="periode">Op periode</option>
                                                <option value="naam">Op naam</option>
                                                <option value="prijs">Op prijs</option>
                                            </select>
                                        </div>
                                        <div class="col-sm-3">
                                            <button type="button" class="btn btn-du-light w-100" title="Volgorde omdraaien" @onclick="() => sortDescending = !sortDescending">@SortDirectionLabel</button>
                                        </div>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th scope="col">Seizoen</th>
                                                    <th scope="col">Periode</th>
                                                    <th scope="col">Prijs per nacht</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (VisibleSeasonPrices(selected).Count == 0)
                                                {
                                                    <tr><td colspan="3" class="text-muted-du">Geen seizoenen gevonden.</td></tr>
                                                }
                                                @foreach (SeasonPriceRequest seasonPrice in VisibleSeasonPrices(selected))
                                                {
                                                    <tr>
                                                        <th scope="row">@SeasonName(seasonPrice.SeasonId)</th>
                                                        <td class="text-nowrap">@SeasonPeriod(seasonPrice.SeasonId)</td>
                                                        <td>
                                                            <label class="visually-hidden" for="@($"{selected.Slug}-{seasonPrice.SeasonId}")">Prijs per nacht voor @SeasonName(seasonPrice.SeasonId)</label>
                                                            <div class="input-group">
                                                                <span class="input-group-text">€</span>
                                                                <InputNumber id="@($"{selected.Slug}-{seasonPrice.SeasonId}")" class="form-control" step="0.01" placeholder="@($"Standaard {selected.DefaultPricePerNight:0.00}")" @bind-Value="seasonPrice.PricePerNight" />
                                                            </div>
                                                            <ValidationMessage For="() => seasonPrice.PricePerNight" />
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                <button type="submit" class="btn btn-du mt-4" disabled="@isBusy">Prijzen @selected.Name opslaan</button>
                            </EditForm>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private const string LoadFailedMessage = "De instellingen konden niet worden opgehaald. Probeer het opnieuw.";
    private const string RulesTab = "parkregels";
    private const string TaxTab = "toeristenbelasting";
    private const string SeasonsTab = "seizoenen";
    private const string PricesTab = "prijzen";

    private static readonly (string Slug, string Title, string Description)[] Tabs =
    [
        (RulesTab, "Parkregels", "Tijden, verblijf en annuleren"),
        (TaxTab, "Toeristenbelasting", "Tarief per persoon per nacht"),
        (SeasonsTab, "Seizoenen", "Periodes en hoogseizoen"),
        (PricesTab, "Prijzen per type", "Nacht- en schoonmaakprijzen"),
    ];

    [Parameter] public string? Tab { get; set; }

    private ParkSettingsResponse? settings;
    private string? loadError;
    private AddTouristTaxRateRequest newRate = new();
    private SaveSeasonRequest season = new();
    private Guid? editingSeasonId;
    private string? selectedTypeSlug;
    private string seasonSearch = string.Empty;
    private string seasonSort = "periode";
    private bool sortDescending;
    private string? message;
    private bool succeeded;
    private bool isBusy;
    private double tabScrollPosition;
    private bool restoreTabScrollPosition;

    // An unknown tab in the URL falls back to the first tab instead of showing an empty page.
    private string ActiveTab => Tabs.Any(tab => tab.Slug == Tab) ? Tab! : RulesTab;

    private string ActiveTabTitle => Tabs.First(tab => tab.Slug == ActiveTab).Title;

    private TypePricesResponse? SelectedType => settings?.Types.FirstOrDefault(type => type.Slug == selectedTypeSlug) ?? settings?.Types.FirstOrDefault();

    // The newest rate that has started; later rates are planned, older ones no longer apply to new nights.
    private AddTouristTaxRateRequest? CurrentRate => settings?.TouristTaxRates
        .Where(rate => rate.ValidFrom <= Today)
        .MaxBy(rate => rate.ValidFrom);

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    private string SortDirectionLabel => (seasonSort, sortDescending) switch
    {
        ("naam", false) => "A → Z",
        ("naam", true) => "Z → A",
        ("prijs", false) => "Laagste eerst",
        ("prijs", true) => "Hoogste eerst",
        (_, false) => "Vroegste eerst",
        (_, true) => "Laatste eerst",
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // Switching tabs keeps typed values (same component), but the last message belongs to the old tab.
    protected override void OnParametersSet() => message = null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!restoreTabScrollPosition)
            return;

        restoreTabScrollPosition = false;
        await JSRuntime.InvokeVoidAsync("setScrollPosition", tabScrollPosition);
    }

    private async Task NavigateToTabAsync(string slug)
    {
        tabScrollPosition = await JSRuntime.InvokeAsync<double>("getScrollPosition");
        restoreTabScrollPosition = true;
        NavigationManager.NavigateTo($"beheer/instellingen/{slug}");
    }

    private async Task AddRateAsync()
    {
        if (await SaveAsync(() => ParkSettingsService.AddTouristTaxRateAsync(newRate), reload: true))
            newRate = new();
    }

    private async Task SaveSeasonAsync()
    {
        Func<Task<ApiResponse<object>>> save = editingSeasonId is null
            ? () => ParkSettingsService.CreateSeasonAsync(season)
            : () => ParkSettingsService.UpdateSeasonAsync(editingSeasonId.Value, season);

        if (await SaveAsync(save, reload: true))
            ResetSeason();
    }

    private void EditSeason(SeasonResponse existing)
    {
        editingSeasonId = existing.Id;
        season = new SaveSeasonRequest { Name = existing.Name, StartDate = existing.StartDate, EndDate = existing.EndDate, IsHighSeason = existing.IsHighSeason };
    }

    private void ResetSeason()
    {
        editingSeasonId = null;
        season = new();
    }

    private async Task DeleteSeasonAsync(SeasonResponse existing)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Seizoen '{existing.Name}' verwijderen? In deze periode geldt daarna de standaardprijs."))
            return;

        if (await SaveAsync(() => ParkSettingsService.DeleteSeasonAsync(existing.Id), reload: true) && existing.Id == editingSeasonId)
            ResetSeason();
    }

    private async Task LoadAsync()
    {
        ApiResponse<ParkSettingsResponse> response = await ParkSettingsService.GetAsync();
        settings = response.Succeeded ? response.Value : null;
        loadError = response.Succeeded ? null : response.Message ?? LoadFailedMessage;
    }

    // Only season and tax changes reload the page, so unsaved prices of other types stay as typed.
    private async Task<bool> SaveAsync(Func<Task<ApiResponse<object>>> save, bool reload = false)
    {
        isBusy = true;
        ApiResponse<object> response = await save();
        isBusy = false;

        succeeded = response.Succeeded;
        message = response.Errors.Count > 0 ? string.Join(" ", response.Errors.SelectMany(error => error.Errors)) : response.Message;
        if (response.Succeeded && reload)
            await LoadAsync();

        return response.Succeeded;
    }

    private string RateStatus(AddTouristTaxRateRequest rate)
    {
        if (rate == CurrentRate)
            return "Geldt nu";

        return rate.ValidFrom > Today ? "Gepland" : "Verlopen";
    }

    private string RateStatusClass(AddTouristTaxRateRequest rate)
    {
        if (rate == CurrentRate)
            return "text-bg-success";

        return rate.ValidFrom > Today ? "text-bg-light border" : "text-bg-light text-muted-du fw-normal";
    }

    private SeasonResponse FindSeason(Guid seasonId) => settings!.Seasons.First(existing => existing.Id == seasonId);

    private string SeasonName(Guid seasonId) => FindSeason(seasonId).Name;

    private string SeasonPeriod(Guid seasonId)
        => $"{FindSeason(seasonId).StartDate?.ToString(DateFormats.Date)} t/m {FindSeason(seasonId).EndDate?.ToString(DateFormats.Date)}";

    // Only changes which rows are shown; hidden season prices are still saved with the form.
    // The seasons arrive in date order, so "periode" keeps that order.
    private List<SeasonPriceRequest> VisibleSeasonPrices(TypePricesResponse type)
    {
        IEnumerable<SeasonPriceRequest> prices = type.SeasonPrices
            .Where(price => SeasonName(price.SeasonId).Contains(seasonSearch.Trim(), StringComparison.OrdinalIgnoreCase));

        List<SeasonPriceRequest> sorted = seasonSort switch
        {
            "naam" => prices.OrderBy(price => SeasonName(price.SeasonId)).ToList(),
            "prijs" => prices.OrderBy(price => price.PricePerNight ?? type.DefaultPricePerNight).ToList(),
            _ => prices.ToList(),
        };

        if (sortDescending)
            sorted.Reverse();

        return sorted;
    }
}
