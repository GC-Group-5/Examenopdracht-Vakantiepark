@page "/zoek-en-boek/bevestiging"

<PageTitle>Boeking bevestigd | Vakantiepark D'r op Uut</PageTitle>

<section class="page-head">
    <div class="container">
        <div class="eyebrow">Boeken</div>
        <h1 class="page-title mt-2">Bedankt voor je boeking</h1>
        <p class="page-intro mt-4">Je boeking is gelukt. We hebben een bevestiging naar je e-mailadres gestuurd.</p>
    </div>
</section>

<section class="section-pad">
    <div class="container">
        <div class="p-4 p-md-5 border rounded-4 bg-white shadow-sm">
            <div class="eyebrow">Je boekingsnummer</div>
            <p class="h2 mt-2 mb-4">@BookingNumber</p>
            <p class="mb-2">Bewaar dit nummer goed. Met je boekingsnummer en e-mailadres log je in op <strong>Mijn boeking</strong>.</p>
            <p class="text-muted-du mb-0">Geen e-mail ontvangen? Kijk ook in je spammap of neem contact op met de receptie.</p>
            <a class="btn btn-du mt-4" href="/">Terug naar home</a>
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "nummer")]
    public string? BookingNumber { get; set; }
}
