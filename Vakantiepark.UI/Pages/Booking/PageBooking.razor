@page "/zoek-en-boek"
@using Vakantiepark.Shared.DTOs.Booking
@using Vakantiepark.UI.Application.Extensions
@inject IBookingService BookingService
@inject NavigationManager NavigationManager

<PageTitle>Boeken | Vakantiepark D'r op Uut</PageTitle>

<section class="page-head">
    <div class="container">
        <BookingSteps CurrentStep="@(showSummary ? 3 : 2)" />
        <div class="eyebrow">Boeken</div>
        <h1 class="page-title mt-2">@(showSummary ? "Controleer je boeking" : "Jouw gegevens")</h1>
        @if (quote is not null)
        {
            <p class="page-intro mt-3 mb-0">
                @quote.AccommodationTypeName · @quote.ArrivalDate.ToString(DateFormats.Date) t/m @quote.DepartureDate.ToString(DateFormats.Date) · @PartyLabel
            </p>
        }
    </div>
</section>

<section class="section-pad">
    <div class="container">
        @if (!HasStay)
        {
            <div class="p-4 p-md-5 border rounded-4 bg-white shadow-sm">
                <p class="mb-0">Kies eerst een verblijf, je data en het aantal personen voordat je boekt.</p>
                <a class="btn btn-du mt-4" href="accommodaties">Bekijk de verblijven</a>
            </div>
        }
        else if (isLoading)
        {
            <div class="p-4 p-md-5 border rounded-4 bg-white shadow-sm" role="status">Je verblijf wordt gecontroleerd…</div>
        }
        else if (quote is null)
        {
            <div class="p-4 p-md-5 border rounded-4 bg-white shadow-sm">
                <div class="alert alert-warning mb-0" role="alert">@errorMessage</div>
                <a class="btn btn-du mt-4" href="accommodaties">Kies een ander verblijf</a>
            </div>
        }
        else
        {
            @* No align-items-start on the row: the card column must stretch, or the sticky card cannot move. *@
            <div class="row g-4">
                <div class="col-lg-5 col-xl-4 order-lg-2">
                    @* The stay being booked, like a listing card: sticky next to the form on large screens, on top on a phone. *@
                    <aside class="booking-card zoek-sidebar">
                        <img class="boek-card-image" src="@($"img/accommodaties/{AccommodationTypeSlug}/1.webp")" alt="@quote.AccommodationTypeName"
                             onerror="this.onerror=null; this.src='img/placeholder-image.svg'" />
                        <div class="eyebrow">Jouw verblijf</div>
                        <h2 class="h3 mt-2 mb-1">@quote.AccommodationTypeName</h2>
                        <p class="small text-muted-du mb-3">@(quote.Zone is null ? "Geen voorkeurszone" : $"Zone {quote.Zone}")</p>

                        <dl class="row small mb-0">
                            <dt class="col-5">Aankomst</dt>
                            <dd class="col-7">@quote.ArrivalDate.ToString(DateFormats.Date)<br /><span class="text-muted-du">vanaf @quote.ArrivalTime.ToString(DateFormats.Time)</span></dd>
                            <dt class="col-5">Vertrek</dt>
                            <dd class="col-7">@quote.DepartureDate.ToString(DateFormats.Date)<br /><span class="text-muted-du">vóór @quote.DepartureTime.ToString(DateFormats.Time)</span></dd>
                            <dt class="col-5">Gezelschap</dt>
                            <dd class="col-7">
                                @PartyLabel@(request.NumberOfPets > 0 ? $", {StayLabels.Pets(request.NumberOfPets)}" : "")
                                @if (request.WheelchairAccessible)
                                {
                                    <br /><span class="text-muted-du">rolstoeltoegankelijk</span>
                                }
                            </dd>
                        </dl>

                        <hr />
                        <h3 class="h6 mb-2">Prijsspecificatie</h3>
                        @if (!HasDates)
                        {
                            <p class="small text-muted-du mb-0">Kies je aankomst- en vertrekdatum om de prijs te zien.</p>
                        }
                        else if (isRefreshingQuote)
                        {
                            <p class="small text-muted-du mb-0" role="status">De prijs wordt bijgewerkt…</p>
                        }
                        else
                        {
                            <PriceSpecification Price="quote.Price" NumberOfNights="NumberOfNights" TaxedGuests="quote.NumberOfGuests - quote.NumberOfChildrenUnder12"
                                                DepositPercentage="quote.DepositPercentage" Compact="true" />
                        }
                    </aside>
                </div>
                <div class="col-lg-7 col-xl-8 order-lg-1">
                    @if (!showSummary)
                    {
                        <EditForm Model="request" OnValidSubmit="ShowSummary" class="p-4 p-md-5 border rounded-4 bg-white shadow-sm">
                            <DataAnnotationsValidator />

                            <h2 class="h5 mb-3">Hoofdboeker</h2>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold" for="booking-guests">Aantal personen</label>
                                    <InputNumber id="booking-guests" class="form-control" Value="request.NumberOfGuests" TValue="int" ValueExpression="() => request.NumberOfGuests" ValueChanged="OnGuestsChangedAsync" min="1" max="@MaxGuestsForStay" step="1" />
                                    <div class="form-text">Telt de hoofdboeker en alle reisgenoten. Maximaal @MaxGuestsForStay personen.</div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-label fw-semibold">Toegankelijkheid</div>
                                    <label class="check-field" for="booking-wheelchair">
                                        <InputCheckbox id="booking-wheelchair" class="form-check-input" Value="request.WheelchairAccessible" ValueExpression="() => request.WheelchairAccessible" ValueChanged="OnWheelchairChangedAsync" />
                                        Rolstoeltoegankelijk verblijf nodig
                                    </label>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-label fw-semibold">Huisdieren</div>
                                    <label class="check-field" for="booking-pets-checkbox">
                                        <InputCheckbox id="booking-pets-checkbox" class="form-check-input" Value="takesPets" ValueExpression="() => takesPets" ValueChanged="OnTakesPetsChangedAsync" disabled="@((quote?.MaxPets ?? 0) < 1)" />
                                        Ik neem huisdieren mee
                                    </label>
                                </div>
                                @if (takesPets)
                                {
                                    <div class="col-12 col-md-6">
                                        <label class="form-label fw-semibold" for="booking-pets">Aantal huisdieren</label>
                                        <InputNumber id="booking-pets" class="form-control" Value="request.NumberOfPets" TValue="int" ValueExpression="() => request.NumberOfPets" ValueChanged="OnPetsChangedAsync" min="1" max="@((quote?.MaxPets ?? 1))" step="1" />
                                        <div class="form-text">Maximaal @StayLabels.Pets(quote?.MaxPets ?? 0).</div>
                                    </div>
                                }
                                @* Keeps Naam on a new row, so name, birth date, email and phone stay in pairs. *@
                                <div class="w-100 d-none d-md-block"></div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold" for="booking-name">Naam</label>
                                    <InputText id="booking-name" class="form-control" @bind-Value="request.Name" placeholder="Voor- en achternaam" autocomplete="name" />
                                    <ValidationMessage For="() => request.Name" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold" for="booking-birthdate">Geboortedatum</label>
                                    <InputDutchDate id="booking-birthdate" class="form-control" MaxYear="@DateTime.Today.Year" @bind-Value="request.BirthDate" @bind-Value:after="CheckMainBookerAge" autocomplete="bday" />
                                    <ValidationMessage For="() => request.BirthDate" />
                                    @if (ageErrorMessage is not null)
                                    {
                                        <div class="validation-message" role="alert">@ageErrorMessage</div>
                                    }
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold" for="booking-email">E-mailadres</label>
                                    <InputText id="booking-email" type="email" class="form-control" @bind-Value="request.Email" placeholder="naam@voorbeeld.nl" autocomplete="email" />
                                    <ValidationMessage For="() => request.Email" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold" for="booking-phone">Telefoonnummer</label>
                                    <InputText id="booking-phone" type="tel" class="form-control" @bind-Value="request.PhoneNumber" placeholder="06 12345678" autocomplete="tel" />
                                    <ValidationMessage For="() => request.PhoneNumber" />
                                </div>
                            </div>

                            @if (request.CoTravellers.Count > 0)
                            {
                                <h2 class="h5 mt-5 mb-1">Reisgenoten <span class="badge rounded-pill text-bg-light border fw-normal align-middle">Optioneel</span></h2>
                                <p class="text-muted-du small mb-3">Deze velden zijn niet verplicht: je kunt ook zonder boeken. Wat je leeg laat, vult de receptie aan bij het inchecken. Over kinderen jonger dan 12 betaal je geen toeristenbelasting. Dat volgt uit de geboortedatum; zonder geboortedatum telt een reisgenoot als 12 jaar of ouder.</p>
                                @for (int index = 0; index < request.CoTravellers.Count; index++)
                                {
                                    int number = index + 2;
                                    TravellerRequest traveller = request.CoTravellers[index];
                                    <div class="row g-3 mb-2">
                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold" for="@($"traveller-name-{number}")">Persoon @number: naam</label>
                                            <InputText id="@($"traveller-name-{number}")" class="form-control" @bind-Value="traveller.Name" placeholder="Optioneel" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold" for="@($"traveller-birthdate-{number}")">Persoon @number: geboortedatum</label>
                                            <InputDutchDate id="@($"traveller-birthdate-{number}")" class="form-control" MaxYear="@DateTime.Today.Year" @bind-Value="traveller.BirthDate" @bind-Value:after="OnTravellerBirthDateChangedAsync" />
                                        </div>
                                    </div>
                                }
                            }

                            @if (quoteErrorMessage is not null)
                            {
                                <div class="alert alert-warning mt-4 mb-0" role="alert">@quoteErrorMessage</div>
                            }

                            @if (errorMessage is not null)
                            {
                                <div class="alert alert-danger mt-4 mb-0" role="alert">@errorMessage</div>
                            }

                            <button type="submit" class="btn btn-du mt-4" disabled="@(isRefreshingQuote || quoteErrorMessage is not null || ageErrorMessage is not null)">
                                @(isRefreshingQuote ? "Verblijf wordt gecontroleerd…" : "Naar de samenvatting")
                            </button>
                        </EditForm>
                    }
                    else
                    {
                        <div class="p-4 p-md-5 border rounded-4 bg-white shadow-sm">
                            <h2 class="h4 mb-4">Samenvatting</h2>
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Verblijf</dt>
                                <dd class="col-sm-8">@quote.AccommodationTypeName</dd>

                                <dt class="col-sm-4">Zone</dt>
                                <dd class="col-sm-8">@(quote.Zone ?? "Geen voorkeur")</dd>

                                <dt class="col-sm-4">Huisdieren</dt>
                                <dd class="col-sm-8">@(request.NumberOfPets == 0 ? "Geen" : StayLabels.Pets(request.NumberOfPets))</dd>
                                @if (quote.Price.PetCleaningFee > 0m)
                                {
                                    <dt class="col-sm-4">Schoonmaakkosten huisdieren</dt>
                                    <dd class="col-sm-8">@quote.Price.PetCleaningFee.ToString("C")</dd>
                                }

                                @if (request.WheelchairAccessible)
                                {
                                    <dt class="col-sm-4">Toegankelijkheid</dt>
                                    <dd class="col-sm-8">Rolstoeltoegankelijk</dd>
                                }

                                <dt class="col-sm-4">Data</dt>
                                <dd class="col-sm-8">@quote.ArrivalDate.ToString(DateFormats.Date) t/m @quote.DepartureDate.ToString(DateFormats.Date) (@StayLabels.Nights(NumberOfNights))</dd>

                                <dt class="col-sm-4">Aankomst en vertrek</dt>
                                <dd class="col-sm-8">Aankomst vanaf @quote.ArrivalTime.ToString(DateFormats.Time), vertrek vóór @quote.DepartureTime.ToString(DateFormats.Time)</dd>

                                <dt class="col-sm-4">Reisgezelschap</dt>
                                <dd class="col-sm-8">
                                    @PartyLabel
                                    <ul class="list-unstyled mb-0">
                                        <li>@TravellerAgeExtensions.TravellerLabel(request.Name, request.BirthDate, request.ArrivalDate, isMainBooker: true)</li>
                                        @foreach (TravellerRequest traveller in NamedTravellers)
                                        {
                                            <li>@TravellerAgeExtensions.TravellerLabel(traveller.Name!, traveller.BirthDate, request.ArrivalDate)</li>
                                        }
                                    </ul>
                                    @if (TravellerAgeExtensions.MissingTravellersLabel(request.NumberOfGuests, NamedTravellers.Count + 1) is string missing)
                                    {
                                        <div class="text-muted-du small">@missing</div>
                                    }
                                </dd>

                                <dt class="col-sm-4">Contactgegevens</dt>
                                <dd class="col-sm-8">@request.Email<br />@request.PhoneNumber</dd>
                            </dl>

                            <h3 class="h5 mt-4 mb-2">Annuleringsvoorwaarden</h3>
                            <ul class="mb-0">
                                <li>Tot @quote.FreeCancellationDaysBeforeArrival dagen voor aankomst annuleer je kosteloos.</li>
                                <li>Daarna tot @quote.NoRefundDaysBeforeArrival dagen voor aankomst vervalt de aanbetaling.</li>
                                <li>Binnen @quote.NoRefundDaysBeforeArrival dagen voor aankomst betaal je het volledige verblijf; de toeristenbelasting krijg je terug.</li>
                            </ul>

                            @if (errorMessage is not null)
                            {
                                <div class="alert alert-danger mt-4 mb-0" role="alert">@errorMessage</div>
                            }

                            <div class="d-flex flex-wrap gap-3 mt-4">
                                <button type="button" class="btn btn-outline-secondary" @onclick="EditDetails" disabled="@isSaving">Gegevens wijzigen</button>
                                <button type="button" class="btn btn-du" @onclick="ConfirmAsync" disabled="@isSaving">
                                    @(isSaving ? "Bezig met boeken…" : "Boeking bevestigen")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private const string QuoteFailedMessage = "Dit verblijf kan nu niet worden geboekt.";
    private const int DefaultGuests = 2;
    private const int MaxGuests = 20;

    private readonly CreateBookingRequest request = new CreateBookingRequest();
    private BookingQuoteResponse? quote;
    private bool takesPets;
    private bool isLoading = true;
    private bool isRefreshingQuote;
    private bool showSummary;
    private bool isSaving;
    private string? errorMessage;
    private string? quoteErrorMessage;
    private string? ageErrorMessage;
    private int quoteRequestNumber;

    [SupplyParameterFromQuery(Name = "type")]
    public string? AccommodationTypeSlug { get; set; }

    [SupplyParameterFromQuery(Name = "aankomst")]
    public DateOnly? ArrivalDate { get; set; }

    [SupplyParameterFromQuery(Name = "vertrek")]
    public DateOnly? DepartureDate { get; set; }

    [SupplyParameterFromQuery(Name = "zone")]
    public string? PreferredZone { get; set; }

    // The party from the search (US-36); the guest can still change persons and pets here.
    [SupplyParameterFromQuery(Name = "personen")]
    public int? Guests { get; set; }

    [SupplyParameterFromQuery(Name = "huisdieren")]
    public int? Pets { get; set; }

    [SupplyParameterFromQuery(Name = "rolstoel")]
    public bool? Wheelchair { get; set; }

    private bool HasStay => !string.IsNullOrWhiteSpace(AccommodationTypeSlug)
        && ArrivalDate is not null
        && DepartureDate > ArrivalDate;

    private bool HasDates => request.ArrivalDate != default && request.DepartureDate != default;

    private int NumberOfNights => StayLabels.NumberOfNights(request.ArrivalDate, request.DepartureDate);

    private int ChildrenUnder12 => request.CoTravellers.CountChildrenUnder12(request.ArrivalDate);

    private string PartyLabel => TravellerAgeExtensions.PartyLabel(request.NumberOfGuests, ChildrenUnder12);

    // The largest free unit of this type caps the party; without a quote only the general maximum applies.
    private int MaxGuestsForStay => quote?.MaxPersons is > 0 ? Math.Min(MaxGuests, quote.MaxPersons) : MaxGuests;

    protected override async Task OnParametersSetAsync()
    {
        if (!HasStay)
            return;

        request.AccommodationTypeSlug = AccommodationTypeSlug!;
        request.ArrivalDate = ArrivalDate!.Value;
        request.DepartureDate = DepartureDate!.Value;
        // The age counts on the arrival date, so a new stay may change the outcome.
        CheckMainBookerAge();
        // A hand-edited URL with an impossible value falls back to the default.
        request.NumberOfGuests = Guests is >= 1 and <= MaxGuests ? Guests.Value : DefaultGuests;
        request.NumberOfPets = Pets is >= 0 and <= BookingRules.MaxPetsInUrl ? Pets.Value : 0;
        takesPets = request.NumberOfPets > 0;
        request.WheelchairAccessible = Wheelchair == true;
        request.PreferredZone = PreferredZone;
        ResizeCoTravellers();

        // The server checks the stay first, so the guest hears about a full period
        // or a too-short high-season stay before filling in any details.
        isLoading = true;
        ApiResponse<BookingQuoteResponse> response = await RequestQuoteAsync();
        isLoading = false;

        quote = response.Succeeded ? response.Value : null;
        errorMessage = response.Succeeded ? null : response.Message ?? QuoteFailedMessage;
        quoteErrorMessage = null;
    }

    private async Task<ApiResponse<BookingQuoteResponse>> RequestQuoteAsync() =>
        await BookingService.GetQuoteAsync(
            request.AccommodationTypeSlug, request.ArrivalDate, request.DepartureDate,
            request.NumberOfGuests, ChildrenUnder12, request.NumberOfPets, request.WheelchairAccessible, request.PreferredZone);

    // Refreshes the quote while the form stays on screen, so a party change does not
    // tear down the form; a rejected party size is shown inline and can be corrected.
    private async Task RefreshQuoteAsync()
    {
        int requestNumber = ++quoteRequestNumber;
        isRefreshingQuote = true;

        ApiResponse<BookingQuoteResponse> response = await RequestQuoteAsync();

        // Quick clicks on the number arrows can return out of order; only the latest counts.
        if (requestNumber != quoteRequestNumber)
            return;

        isRefreshingQuote = false;

        if (response.Succeeded && response.Value is not null)
        {
            quote = response.Value;
            quoteErrorMessage = null;
            return;
        }

        quoteErrorMessage = response.Message ?? QuoteFailedMessage;
    }

    // Fewer persons drop the last traveller rows, and with them maybe a child under 12.
    private async Task OnGuestsChangedAsync(int newGuests)
    {
        int clampedGuests = Math.Clamp(newGuests, 1, MaxGuestsForStay);
        if (clampedGuests == request.NumberOfGuests)
            return;

        request.NumberOfGuests = clampedGuests;
        ResizeCoTravellers();
        await OnPartyChangedAsync();
    }

    private List<TravellerRequest> NamedTravellers
        => request.CoTravellers.Where(traveller => !string.IsNullOrWhiteSpace(traveller.Name)).ToList();

    // One row per fellow traveller; what was already filled in stays.
    private void ResizeCoTravellers()
    {
        List<TravellerRequest> previous = request.CoTravellers;
        request.CoTravellers = Enumerable.Range(0, Math.Max(request.NumberOfGuests - 1, 0))
            .Select(index => index < previous.Count ? previous[index] : new TravellerRequest())
            .ToList();
    }

    // A birth date can make someone under 12, who pays no tourist tax, so then the price is fetched again.
    private async Task OnTravellerBirthDateChangedAsync()
    {
        if (quote is null || quote.NumberOfChildrenUnder12 != ChildrenUnder12)
            await OnPartyChangedAsync();
    }

    // Pets decide which units may be picked, so the quote is checked again.
    private async Task OnPetsChangedAsync(int newPets)
    {
        int maxPets = Math.Max(quote?.MaxPets ?? 0, 1);
        request.NumberOfPets = Math.Clamp(newPets, 1, maxPets);
        quoteErrorMessage = null;
        await OnPartyChangedAsync();
    }

    private async Task OnTakesPetsChangedAsync(bool takesPets)
    {
        this.takesPets = takesPets;
        request.NumberOfPets = takesPets && quote is not null && quote.MaxPets > 0 ? 1 : 0;
        await OnPartyChangedAsync();
    }

    // Only accessible units may be picked, so the quote is checked again.
    private async Task OnWheelchairChangedAsync(bool wheelchairAccessible)
    {
        request.WheelchairAccessible = wheelchairAccessible;
        await OnPartyChangedAsync();
    }

    private async Task OnPartyChangedAsync()
    {
        if (!HasStay || request.NumberOfGuests < 1)
            return;

        await RefreshQuoteAsync();
    }

    // Shown straight after the birth date is filled in; the server checks the same rule again.
    private void CheckMainBookerAge()
    {
        ageErrorMessage = request.BirthDate is DateOnly birthDate && birthDate.AgeOn(request.ArrivalDate) < BookingRules.MinimumMainBookerAge
            ? $"De hoofdboeker moet op de aankomstdatum minimaal {BookingRules.MinimumMainBookerAge} jaar zijn."
            : null;
    }

    private void ShowSummary()
    {
        if (isRefreshingQuote || quoteErrorMessage is not null || ageErrorMessage is not null)
            return;

        errorMessage = null;
        showSummary = true;
    }

    private void EditDetails()
    {
        errorMessage = null;
        showSummary = false;
    }

    private async Task ConfirmAsync()
    {
        isSaving = true;
        errorMessage = null;

        ApiResponse<BookingResponse> response = await BookingService.CreateAsync(request);

        isSaving = false;

        if (!response.Succeeded || response.Value is null)
        {
            errorMessage = response.Message ?? "Je boeking kon niet worden opgeslagen. Probeer het opnieuw.";
            return;
        }

        NavigationManager.NavigateTo($"/zoek-en-boek/bevestiging?nummer={response.Value.BookingNumber}");
    }
}
