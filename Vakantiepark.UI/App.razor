<RedirectGuestToHome />

<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(PageNotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <PageNotFound />
            </NotAuthorized>
            <Authorizing>
                <div class="container py-5 text-center">
                    <div class="spinner-border text-success" role="status"><span class="visually-hidden">Bezig met laden…</span></div>
                </div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>
