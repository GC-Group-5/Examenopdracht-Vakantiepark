    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>13399d39-ba80-40a3-90cf-fcc325ba7a83</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vakantiepark.API\Vakantiepark.API.csproj" />
    <ProjectReference Include="..\Vakantiepark.UI\Vakantiepark.UI.csproj" />
  </ItemGroup>

</Project>
